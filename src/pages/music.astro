---
import Base from '../layouts/Base.astro';
import PageColumns from '../components/PageColumns.astro';
import LastfmWidget from '../components/LastfmWidget.astro';
import { site } from '../site';
---
<Base title="music" description="a live look at what i've been listening to, pulled from last.fm.">
<PageColumns prose={false}>
  <Fragment slot="aside">
    <p class="post-date">live from <a href={`https://www.last.fm/user/${site.lastfm.username}`}>last.fm</a></p>
    <LastfmWidget id="lastfm-now" count={11} historyId="lastfm-history" />
  </Fragment>
  <h2>history</h2>
  <div class="card-grid history" id="lastfm-history">
    <p class="lastfm-status">loading…</p>
  </div>
</PageColumns>
</Base>

<style>
  /* The rows are built at runtime by lastfm.ts, so they are reached with
     :global() under this scoped container. The row itself is the link and
     inherits the flat hover fill from .card in cards.css. */
  .history :global(.lastfm-status) {
    margin: 0;
    font-size: var(--type-caption);
    font-weight: var(--type-caption-weight);
    line-height: var(--type-caption-leading);
    text-transform: lowercase;
    color: var(--ctp-subtext0);
  }
  .history :global(.lastfm-history-card) {
    display: flex;
    align-items: center;
    gap: var(--space-2); /* hard-edged art next to text: the 10px gutter */
    min-height: var(--touch-target);
  }
  .history :global(.lastfm-history-cover) {
    flex: 0 0 auto;
    /* Four grid units square: as tall as the three lines of text beside it. */
    width: calc(4 * var(--space-4));
    height: calc(4 * var(--space-4));
    color: var(--ctp-overlay0);
  }
  .history :global(.lastfm-history-info) {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-width: 0;
  }
  /* Placeholder bars stand where title, artist and time land. */
  .history :global(.lastfm-history-skeleton .lastfm-history-info) {
    gap: var(--space-1);
  }
  .history :global(.lastfm-history-info .card-date) {
    margin: var(--space-1) 0 0;
  }
</style>
