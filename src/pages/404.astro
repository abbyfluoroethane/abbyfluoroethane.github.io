---
import Base from '../layouts/Base.astro';
import BackButton from '../components/BackButton.astro';
---
<Base title="404" appName="not found">
  <div class="not-found">
    <p>The URL may be wrong, or the link has gone stale.</p>
    <BackButton href="/" label="home" />
  </div>
</Base>

<style>
  /* The shared header carries the overline and the hero. No loud element. */
  .not-found p {
    margin: 0 0 var(--space-4);
    max-width: 42ch;
    color: var(--muted);
  }
</style>
