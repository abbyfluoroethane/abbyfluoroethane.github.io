---
import Base from '../layouts/Base.astro';
---
<Base title="404" bare>
  <div class="bsod" role="alert" aria-live="polite">
    <div class="bsod-inner">
      <p class="bsod-face" aria-hidden="true">:(</p>
      <p class="bsod-text">
        This page doesn't exist. <br>
        You may have entered the URL wrong, or the link has gone stale.
      </p>
      <div class="bsod-detail">
        <p class="bsod-detail-line">If you'd like to know more, you can search online later for this error:</p>
        <p class="bsod-code">0x00000194 PAGE_NOT_FOUND</p>
        <p class="bsod-detail-line"><a href="/">go home</a></p>
      </div>
    </div>
  </div>
</Base>
