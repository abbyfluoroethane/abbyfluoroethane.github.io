---
import Base from '../layouts/Base.astro';
---
<Base title="404" bare>
  <main class="bsod" role="alert" aria-live="polite">
    <div class="bsod-inner">
      <p class="bsod-face" aria-hidden="true">:(</p>
      <p class="bsod-text">
        This page doesn't exist. <br>
        You may have entered the URL wrong, or the link has gone stale.
      </p>
      <div class="bsod-detail">
        <p class="bsod-detail-line">If you'd like to know more, you can search online later for this error:</p>
        <p class="bsod-code">0x00000194 PAGE_NOT_FOUND</p>
        <p class="bsod-detail-line"><a href="/">go home</a></p>
      </div>
    </div>
  </main>
</Base>

<style>
  /* Windows 8 "sad face" bluescreen homage, ported from the Jekyll Metro
     site. A real bluescreen is a fixed blue, not a themed surface, so this
     page ignores the Catppuccin tokens on purpose. #1a73c9 gives white text
     4.84:1 contrast (clears AA). The page is bare: no header, no nav. */
  .bsod {
    position: fixed;
    inset: 0;
    z-index: 1000;
    overflow-y: auto;
    /* Top-anchored, not centered: a real bluescreen sits at the same height
       whatever the message length. The insets come from measuring a real
       1920x1080 sad-face screenshot. */
    padding: 13vh 1.5rem 3rem 0.625rem;
    background: #1a73c9;
    color: #fff;
    font-family: "Segoe UI", var(--font-sans);
  }
  @media (min-width: 768px) {
    .bsod {
      padding: 13vh 4rem 3rem 12.5rem;
    }
  }
  .bsod-inner {
    max-width: 720px;
  }
  .bsod-face {
    margin: 0 0 1.5rem;
    font-size: clamp(6.5rem, 11vw, 13.3125rem);
    font-weight: 300;
    line-height: 1;
  }
  .bsod-text {
    margin: 0 0 2rem;
    max-width: 42ch;
    font-size: clamp(1.75rem, 2.1vw, 2.5rem);
    font-weight: 300;
    line-height: 1.5;
  }
  .bsod-detail {
    font-size: 1.125rem;
    font-weight: 300;
    line-height: 1.6;
  }
  .bsod-detail-line {
    margin: 0 0 0.5rem;
  }
  .bsod-code {
    margin: 0 0 1.25rem;
    font-family: var(--font-mono);
    letter-spacing: 0.02em;
  }
  .bsod-detail a,
  .bsod-detail a:visited {
    color: #fff;
    text-decoration: underline;
  }
  .bsod-detail a:hover {
    opacity: 0.85;
  }
</style>
