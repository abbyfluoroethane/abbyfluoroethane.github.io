---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const all = await getCollection('projects');
const byDateDesc = (a: any, b: any) =>
  (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0);
const active = all.filter((p) => p.data.status === 'active').sort(byDateDesc);
const archived = all.filter((p) => p.data.status === 'archive').sort(byDateDesc);
---

<Base title="projects" currentPath="/projects/" currentSection="projects">
  <h2 id="active">active</h2>

  <div class="card-grid">
    {active.map((project) => <ProjectCard project={project} />)}
  </div>

  <h2 id="archive">archive</h2>

  <div class="card-grid">
    {archived.map((project) => <ProjectCard project={project} />)}
  </div>
</Base>
