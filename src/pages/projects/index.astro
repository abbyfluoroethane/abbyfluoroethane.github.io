---
// Projects as a panorama, like the blog: the newest featured project with a
// write-up is the hero; the rest sit in an "active" and an "archive" column
// under a giant faded label, like the Zune panorama's section titles.
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/collections';

type Project = CollectionEntry<'projects'>;

const projects = await getProjects();
const hero = projects.find((p) => p.data.featured && p.data.article) ?? projects[0];
const rest = projects.filter((p) => p !== hero);
const columns = [
  { id: 'active', projects: rest.filter((p) => p.data.status === 'active') },
  { id: 'archive', projects: rest.filter((p) => p.data.status === 'archive') },
].filter((c) => c.projects.length > 0);

const href = (p: Project) => (p.data.article ? `/projects/${p.id}/` : undefined);
const years = (p: Project) =>
  p.data.status === 'active' ? `${p.data.date.getUTCFullYear()} – present` : `${p.data.date.getUTCFullYear()}`;
---
<Base title="projects">
  <article class="hero">
    <h2>
      {href(hero) ? <a href={href(hero)}>{hero.data.title}</a> : hero.data.title}
    </h2>
    <p class="caption">
      <span class={`status-pill status-${hero.data.status}`}>{hero.data.status}</span>
      <span> {years(hero)}</span>
    </p>
    <p class="summary">{hero.data.description}</p>
    <p class="links">
      {href(hero) && <a href={href(hero)}>read more →</a>}
      {hero.data.external_url && <a href={hero.data.external_url}>{hero.data.url_text ?? 'external link'} →</a>}
    </p>
  </article>

  <div class="columns">
    {columns.map(({ id, projects }) => (
      <section aria-labelledby={id}>
        <h2 id={id} class="label">{id}</h2>
        <ul>
          {projects.map((p) => (
            <li>
              <h3>{href(p) ? <a href={href(p)}>{p.data.title}</a> : p.data.title}</h3>
              <p class="desc">{p.data.description}</p>
              <p class="caption">
                <span>{years(p)}</span>
                {p.data.external_url && (
                  <a href={p.data.external_url}>{p.data.url_text ?? 'external link'} →</a>
                )}
              </p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>

<style>
  .hero {
    margin-top: var(--space-8);
    margin-bottom: var(--space-16);
  }
  .hero h2 {
    max-width: 14em;
    margin: 0 0 var(--space-4);
    font-size: var(--type-display);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  h2 a,
  h3 a {
    color: var(--ctp-text);
  }
  h2 a:hover,
  h3 a:hover {
    color: var(--ctp-pink);
    text-decoration: none;
  }
  .caption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: var(--space-4);
    margin: 0;
    font-size: var(--type-caption);
    line-height: var(--type-caption-leading);
    color: var(--ctp-subtext0);
  }
  .hero .caption {
    column-gap: var(--space-2);
    margin-bottom: var(--space-3);
  }
  .summary {
    max-width: 38em;
    margin: 0;
    font-size: var(--type-item);
    line-height: var(--type-item-leading);
    color: var(--ctp-subtext1);
  }
  /* Links: a full touch target each, at caption or body size. */
  .links {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-6);
    margin: var(--space-2) 0 0;
  }
  .links a,
  .caption a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    font-weight: var(--type-title-weight);
  }

  /* Phone and tablet: the columns stack. Desktop: side by side. */
  .columns {
    display: grid;
    gap: var(--space-12) var(--space-16);
  }
  @media (min-width: 1000px) {
    .columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .columns section {
    container-type: inline-size; /* the label sizes to its column */
  }
  .label {
    /* A decoration size outside the ramp, like the blog's year numerals.
       "archive" in Selawik Light is about 3.6em wide, so 26cqi fits. */
    margin: 0 0 var(--space-4);
    overflow: hidden;
    white-space: nowrap;
    font-size: min(clamp(4rem, 9vw, 7rem), 26cqi); /* 64-112px */
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--ctp-surface1);
  }
  @media (prefers-color-scheme: dark) {
    .label {
      color: var(--ctp-surface0);
    }
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    max-width: none;
    margin-bottom: var(--space-6);
  }
  h3 {
    margin: 0;
  }
  .desc {
    margin: var(--space-1) 0 0;
    color: var(--ctp-subtext1);
  }
</style>
