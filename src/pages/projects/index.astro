---
// Projects as a panorama, like the blog: an "active" and an "archive" column
// under a giant faded label, like the Zune panorama's section titles.
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/collections';

type Project = CollectionEntry<'projects'>;

const projects = await getProjects();
const columns = [
  { id: 'active', projects: projects.filter((p) => p.data.status === 'active') },
  { id: 'archive', projects: projects.filter((p) => p.data.status === 'archive') },
].filter((c) => c.projects.length > 0);

const href = (p: Project) => (p.data.article ? `/projects/${p.id}/` : undefined);
const years = (p: Project) =>
  p.data.status === 'active' ? `${p.data.date.getUTCFullYear()} – present` : `${p.data.date.getUTCFullYear()}`;
---
<Base title="projects">
  <div class="columns">
    {columns.map(({ id, projects }) => (
      <section aria-labelledby={id}>
        <h2 id={id} class="label">{id}</h2>
        <ul>
          {projects.map((p) => (
            <li>
              <h3>{href(p) ? <a href={href(p)}>{p.data.title}</a> : p.data.title}</h3>
              <p class="desc">{p.data.description}</p>
              <p class="caption">
                <span>{years(p)}</span>
                {p.data.external_url && (
                  <a href={p.data.external_url}>{p.data.url_text ?? 'external link'} →</a>
                )}
              </p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>

<style>
  h3 a {
    color: var(--ctp-text);
  }
  h3 a:hover {
    color: var(--ctp-pink);
    text-decoration: none;
  }
  .caption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: var(--space-4);
    margin: 0;
    font-size: var(--type-caption);
    line-height: var(--type-caption-leading);
    color: var(--ctp-subtext0);
  }
  /* Links: a full touch target each. */
  .caption a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    font-weight: var(--type-title-weight);
  }

  /* Phone and tablet: the columns stack. Desktop: side by side. */
  .columns {
    display: grid;
    gap: var(--space-12) var(--space-16);
  }
  @media (min-width: 1000px) {
    .columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .columns section {
    container-type: inline-size; /* the label sizes to its column */
  }
  .label {
    /* A decoration size outside the ramp, like the blog's year numerals.
       "archive" in Selawik Light is about 3.6em wide, so 26cqi fits. */
    margin: 0 0 var(--space-4);
    overflow: hidden;
    white-space: nowrap;
    font-size: min(clamp(4rem, 9vw, 7rem), 26cqi); /* 64-112px */
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--ctp-surface1);
  }
  @media (prefers-color-scheme: dark) {
    .label {
      color: var(--ctp-surface0);
    }
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    max-width: none;
    margin-bottom: var(--space-6);
  }
  h3 {
    margin: 0;
  }
  .desc {
    margin: var(--space-1) 0 0;
    color: var(--ctp-subtext1);
  }
</style>
