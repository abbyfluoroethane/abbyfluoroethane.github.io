---
import Base from '../../layouts/Base.astro';
import CardGrid from '../../components/CardGrid.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/collections';

const projects = await getProjects();
const sections = [
  { id: 'active', projects: projects.filter((p) => p.data.status === 'active') },
  { id: 'archive', projects: projects.filter((p) => p.data.status === 'archive') },
];
---
<Base title="projects">
  {sections.map((section) => (
    <>
      <h2 id={section.id}>{section.id}</h2>
      <CardGrid>
        {section.projects.map((project) => <ProjectCard {project} />)}
      </CardGrid>
    </>
  ))}
</Base>
