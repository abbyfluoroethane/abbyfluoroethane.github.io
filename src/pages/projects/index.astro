---
// Projects: one loud tile (the first project with a stat), then "active" and
// "archive" lists as rows. The rest of the view is base.
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/collections';

type Project = CollectionEntry<'projects'>;

const projects = await getProjects();
const loud = projects.find((p) => p.data.stat);
const columns = [
  { id: 'active', projects: projects.filter((p) => p.data.status === 'active') },
  { id: 'archive', projects: projects.filter((p) => p.data.status === 'archive') },
].filter((c) => c.projects.length > 0);

const href = (p: Project) => (p.data.article ? `/projects/${p.id}/` : undefined);
const years = (p: Project) =>
  p.data.status === 'active' ? `${p.data.date.getUTCFullYear()} – present` : `${p.data.date.getUTCFullYear()}`;
---
<Base title="projects">
  {loud?.data.stat && (
    <div class="loud-tile">
      <span class="overline">{loud.data.stat.overline ?? loud.data.title}</span>
      <span class="numeral">{loud.data.stat.value} <small>{loud.data.stat.unit}</small></span>
      <span class="label">
        {href(loud) ? <a href={href(loud)}>{loud.data.stat.label}</a> : loud.data.stat.label}
      </span>
    </div>
  )}
  <div class="columns">
    {columns.map(({ id, projects }) => (
      <section aria-labelledby={id}>
        <h2 id={id} class="overline muted">{id}</h2>
        <ul>
          {projects.map((p) => (
            <li class="card">
              <div class="card-head">
                <h3 class="card-title">{href(p) ? <a href={href(p)}>{p.data.title}</a> : p.data.title}</h3>
                <p class="card-date">{years(p)}</p>
              </div>
              <p class="card-desc">{p.data.description}</p>
              <p class="card-meta">
                {p.data.status === 'active'
                  ? <span class="status ok">Active</span>
                  : <span class="status">Archived</span>}
                {p.data.external_url && (
                  <a class="card-link" href={p.data.external_url}>{p.data.url_text || 'External link'} ↗</a>
                )}
              </p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>

<style>
  /* The loud tile: raised, a 6px energy bar across the top edge. 2 x 2 tile
     units at least. Text stays --text on raised. */
  .loud-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-2);
    box-sizing: border-box;
    width: fit-content;
    min-width: calc(2 * var(--tile-unit) + var(--tile-gap));
    min-height: calc(2 * var(--tile-unit) + var(--tile-gap));
    margin: 0 0 var(--space-12);
    padding: var(--space-3) var(--space-4) var(--space-3);
    padding-top: calc(var(--bar-edge) + var(--space-3));
    background: var(--raised);
    color: var(--text);
  }
  .loud-tile::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: var(--bar-edge);
    background: var(--energy-bar);
  }
  .loud-tile .numeral {
    font-size: 4.5rem; /* 72px: the low end of the numeral range */
  }

  .columns {
    display: grid;
    gap: var(--space-12) var(--space-16);
  }
  @media (min-width: 1000px) {
    .columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  h2 {
    margin: 0 0 var(--space-4);
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    max-width: none;
    margin-bottom: var(--space-6);
  }
  /* A link next to the stretched title link stays clickable. */
  .card-link {
    position: relative;
    z-index: 1;
  }
</style>
