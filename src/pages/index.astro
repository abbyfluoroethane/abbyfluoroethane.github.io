---
import Base from '../layouts/Base.astro';
import LastfmWidget from '../components/LastfmWidget.astro';
import { getGuestbook, getNav, getPosts, getProjects } from '../lib/collections';
import Tile from '../components/tiles/Tile.astro';
import TileGrid from '../components/tiles/TileGrid.astro';
import TileLive from '../components/tiles/TileLive.astro';
import { excerpt, truncateWords } from '../lib/format';

const nav = await getNav();
const latestPost = (await getPosts())[0];
const latestPostDesc = latestPost
  ? truncateWords(latestPost.data.summary ?? excerpt(latestPost.body), 20, '')
  : '';
const projects = await getProjects();
// Oldest featured project first, so the cycle starts with the longest-running
// one. Only active projects are featured.
const featuredProjects = projects
  .filter((p) => p.data.featured && p.data.status === 'active')
  .reverse();
const recentEntries = (await getGuestbook()).slice(0, 3);
---

<Base appName="home">
  <div class="home-layout">
    <div class="home-intro">
      <h2 class="fk-heading">haiii, i'm abby :3</h2>
      <p class="fk-muted">Welcome to my little corner of the internet. I build things that go to space, break things that stay on earth, and occasionally muse about my thoughts.</p>
    </div>

    <div class="home-tiles">
    <TileGrid>
      {nav.map((s) => {
        const tile = { size: s.size, color: s.color, icon: s.icon, href: s.url, label: s.name };
        if (s.live === 'blog') return (
          <Tile {...tile} live>
            <TileLive>
              {latestPost && (
                <>
                  <p class="tile-live-title tile-clamp">{latestPost.data.title}</p>
                  <p class="tile-live-desc blog-desc">{latestPostDesc}</p>
                </>
              )}
            </TileLive>
          </Tile>
        );
        if (s.live === 'music') return (
          <Tile {...tile} live art>
            <TileLive strip><LastfmWidget id="lastfm-tile" count={1} tile={true} /></TileLive>
          </Tile>
        );
        // The featured projects taking turns. Only the item on show is
        // exposed to assistive technology, so the tile link is named by its
        // overline and the one item, not by every item in the cycle.
        if (s.live === 'projects') return (
          <Tile {...tile} live>
            <TileLive cycle>
              <div class="tile-cycle-viewport">
                {featuredProjects.map((p, i) => (
                  <div class:list={['tile-cycle-item', { 'is-active': i === 0 }]} aria-hidden={i === 0 ? undefined : 'true'}>
                    <p class="tile-live-title">{p.data.title}</p>
                    <p class="tile-live-years fk-data">{p.data.date.getUTCFullYear()} – present</p>
                    <p class="tile-live-desc" style="--tile-lines: 3">{p.data.description}</p>
                  </div>
                ))}
              </div>
            </TileLive>
          </Tile>
        );
        if (s.live === 'guestbook') return (
          <Tile {...tile} live>
            <TileLive cycle>
              <div class="tile-cycle-viewport">
                {recentEntries.map((e, i) => (
                  <div class:list={['tile-cycle-item', { 'is-active': i === 0 }]} aria-hidden={i === 0 ? undefined : 'true'}>
                    <p class="tile-live-title">{e.name}</p>
                    <p class="tile-live-desc" style="--tile-lines: 4">{e.message}</p>
                  </div>
                ))}
              </div>
            </TileLive>
          </Tile>
        );
        return <Tile {...tile} nav external={s.url.startsWith('http')} />;
      })}
    </TileGrid>
    {/* Stops the tiles that change by themselves. home.ts shows it only
        when a cycle is running, and keeps the choice between visits. */}
    <button class="tile-pause fk-overline" type="button" aria-pressed="false" hidden>pause tiles</button>
    </div>
  </div>
</Base>

<style>
  /* The intro and the tile field sit side by side when the row holds both:
     120px margin + 320px intro + 64px gap + 632px tiles + 64px right
     padding is 1200. Narrower, they stack. */
  .home-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--fk-space-8);
  }
  @media (min-width: 768px) {
    .home-layout {
      gap: var(--fk-space-16);
    }
  }
  @media (min-width: 1200px) {
    .home-layout {
      grid-template-columns: minmax(320px, 420px) max-content;
      align-items: start;
    }
  }
  /* The grid item must not stretch: the tile field sets its own width. */
  .home-tiles {
    min-width: 0;
  }
  /* A text control in the overline style, under the field. 40px tall. */
  .tile-pause {
    display: inline-flex;
    align-items: center;
    min-height: var(--fk-touch-target);
    margin: var(--fk-space-2) 0 0 calc(-1 * var(--fk-space-2));
    padding: 0 var(--fk-space-2);
    border: 0;
    background: none;
    color: var(--fk-muted);
  }
  .tile-pause:hover,
  .tile-pause[aria-pressed='true'] {
    color: var(--fk-text);
  }
  .tile-pause:hover {
    background-color: var(--fk-hover);
  }
  .tile-pause[aria-pressed='true']::before {
    content: '';
    width: 8px;
    height: 8px;
    margin-right: var(--fk-space-2);
    background: var(--fk-accent);
  }
  .home-intro h2 {
    margin: 0 0 var(--fk-space-2);
  }
  .home-intro p {
    margin: 0;
  }
  /* Wide tiles on a phone are short: one line of description fits. */
  .blog-desc {
    --tile-lines: 2;
  }
  @media (max-width: 599px) {
    .blog-desc {
      --tile-lines: 1;
    }
  }
  .tile-clamp {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
