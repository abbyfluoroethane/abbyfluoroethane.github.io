---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import LastfmWidget from '../components/LastfmWidget.astro';
import nav from '../data/nav.yml';
import guestbook from '../../_data/guestbook.yml';

// site.posts | first — newest post by date
const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const latestPost = posts[0];

// Liquid: summary | default: excerpt | strip_html | truncatewords: 20, ""
// Jekyll's excerpt is the first paragraph of the body, rendered to HTML.
function stripHtml(s: string) {
  return s
    .replace(/<script[\s\S]*?<\/script>/gi, '')
    .replace(/<style[\s\S]*?<\/style>/gi, '')
    .replace(/<!--[\s\S]*?-->/g, '')
    .replace(/<[^>]*>/g, '');
}
function excerptText(body: string) {
  const first = (body ?? '').trim().split(/\n\s*\n/)[0] ?? '';
  return first
    .replace(/!\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/(\*\*|__)(.*?)\1/g, '$2')
    .replace(/(\*|_)(.*?)\1/g, '$2')
    .replace(/`([^`]*)`/g, '$1');
}
function truncateWords(s: string, n: number) {
  const words = s.split(/\s+/).filter(Boolean);
  return words.length > n ? words.slice(0, n).join(' ') : words.join(' ');
}
const latestPostDesc = latestPost
  ? truncateWords(
      stripHtml(latestPost.data.summary || excerptText(latestPost.body ?? '')),
      20,
    )
  : '';

// site.projects order: Jekyll sorts collection docs by date (then path)
const featuredProjects = (await getCollection('projects'))
  .filter((p) => p.data.featured === true)
  .sort(
    (a, b) =>
      a.data.date.valueOf() - b.data.date.valueOf() || a.id.localeCompare(b.id),
  );

// site.data.guestbook | reverse | slice: 0, 3
const recentEntries = [...guestbook].reverse().slice(0, 3);

const tileClass = (s: any) => {
  const size = s.size ?? 'square';
  const base = size === 'wide' ? 'tile-wide' : size === 'large' ? 'tile-large' : 'tile';
  const live = ['blog', 'music', 'projects', 'guestbook'].includes(s.name)
    ? ' tile-live-tile'
    : '';
  return `${base} bg-ctp-${s.color ?? 'pink'}${live}`;
};
---

<Base currentPath={Astro.url.pathname}>
  <div class="home-layout">
    <div class="home-intro">
      <h1 class="home-heading">haii, i'm abby :3</h1>
      <p>welcome to my little corner of the internet. i build things that go to space, break things that stay on earth, and occasionally muse about my thoughts.</p>
    </div>

    <div class="home-tiles">
      <div class="tile-grid">
        {nav.map((s: any) => (
          <a class={tileClass(s)} href={s.url}>
            {s.name === 'blog' ? (
              <div class="tile-live tile-live-caption">
                <p class="tile-live-label">latest post</p>
                {latestPost && (
                  <>
                    <p class="tile-live-title">{latestPost.data.title}</p>
                    <p class="tile-live-desc">{latestPostDesc}</p>
                  </>
                )}
              </div>
            ) : s.name === 'music' ? (
              <div class="tile-live"><LastfmWidget id="lastfm-tile" count={1} tile={true} /></div>
            ) : s.name === 'projects' ? (
              <div class="tile-live tile-live-caption tile-cycle">
                <p class="tile-live-label">featured project</p>
                {featuredProjects.map((p, i) => (
                  <div class={`tile-cycle-item${i === 0 ? ' is-active' : ''}`}>
                    <p class="tile-live-title">{p.data.title}</p>
                    <p class="tile-live-years">{p.data.date.getUTCFullYear()} – present</p>
                    <p class="tile-live-desc">{p.data.description}</p>
                  </div>
                ))}
              </div>
            ) : s.name === 'guestbook' ? (
              <div class="tile-live tile-live-caption tile-cycle">
                <p class="tile-live-label">recent guestbook</p>
                {recentEntries.map((e: any, i: number) => (
                  <div class={`tile-cycle-item${i === 0 ? ' is-active' : ''}`}>
                    <p class="tile-live-title">{e.name}</p>
                    <p class="tile-live-desc">{e.message}</p>
                  </div>
                ))}
              </div>
            ) : (
              <div class="tile-content iconic"><span class={`icon ${s.icon}`}></span></div>
            )}
            <span class="tile-label">{s.name}</span>
          </a>
        ))}
      </div>
      <script is:inline>
      (function () {
        var cycles = [].slice.call(document.querySelectorAll(".tile-cycle"));
        cycles.forEach(function (cycle) {
          var items = cycle.querySelectorAll(".tile-cycle-item");
          if (items.length < 2) return;
          var i = 0;
          setInterval(function () {
            items[i].classList.remove("is-active");
            i = (i + 1) % items.length;
            items[i].classList.add("is-active");
          }, 15000);
        });
      })();
      </script>
      <script is:inline>
      (function () {
        // stagger the entrance animation by visual row, not DOM order — grid-
        // auto-flow: dense means a tile's position in the markup often isn't
        // its position on screen, so a flat per-item delay wouldn't line rows
        // up together.
        var tiles = [].slice.call(document.querySelectorAll(".tile-grid > a"));
        var tops = tiles.map(function (t) { return t.offsetTop; });
        var rows = tops
          .filter(function (top, i) { return tops.indexOf(top) === i; })
          .sort(function (a, b) { return a - b; });
        tiles.forEach(function (t) {
          var row = rows.indexOf(t.offsetTop);
          t.style.animationDelay = (180 + row * 70) + "ms";
        });
      })();
      </script>
    </div>
  </div>
</Base>
