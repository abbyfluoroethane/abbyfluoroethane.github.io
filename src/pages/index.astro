---
import Base from '../layouts/Base.astro';
import LastfmWidget from '../components/LastfmWidget.astro';
import { getGuestbook, getNav, getPosts, getProjects } from '../lib/collections';
import Tile from '../components/tiles/Tile.astro';
import TileGrid from '../components/tiles/TileGrid.astro';
import TileLive from '../components/tiles/TileLive.astro';

const nav = await getNav();
const latestPost = (await getPosts())[0];
const activeProjects = (await getProjects()).filter((p) => p.data.status === 'active').length;
const latestEntry = (await getGuestbook())[0];
---

<Base appName="haii, i'm abby :3">
  <div class="home-layout">
    <div class="home-intro">
      <p class="muted">welcome to my little corner of the internet. i build things that go to space, break things that stay on earth, and occasionally muse about my thoughts.</p>
    </div>

    <TileGrid>
      {nav.map((s) => {
        const tile = { size: s.size, fill: s.fill, href: s.url, label: s.name };
        if (s.name === 'blog') return (
          <Tile {...tile} live>
            <TileLive>
              {latestPost && <p class="tile-live-desc is-oneline">{latestPost.data.title}</p>}
            </TileLive>
          </Tile>
        );
        if (s.name === 'music') return (
          <Tile {...tile} live art>
            <TileLive strip><LastfmWidget id="lastfm-tile" count={1} tile={true} /></TileLive>
          </Tile>
        );
        // The one loud tile of the view.
        if (s.name === 'projects') return (
          <Tile {...tile} loud>
            <p class="numeral tile-numeral">{activeProjects}<small>active</small></p>
            <p class="small tile-note">all projects →</p>
          </Tile>
        );
        if (s.name === 'guestbook') return (
          <Tile {...tile} live>
            <TileLive>
              {latestEntry && (
                <>
                  <p class="tile-live-title">{latestEntry.name}</p>
                  <p class="tile-live-desc" style="--tile-lines: 3">{latestEntry.message}</p>
                </>
              )}
            </TileLive>
          </Tile>
        );
        return <Tile {...tile} external={s.url.startsWith('http')} />;
      })}
    </TileGrid>
  </div>
</Base>

<style>
  /* The intro and the tile field sit side by side when the row holds both:
     120px margin + 320px intro + 80px gap + 568px tiles + 64px right
     padding is 1152. Narrower, they stack. */
  .home-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }
  @media (min-width: 768px) {
    .home-layout {
      gap: var(--space-16);
    }
  }
  @media (min-width: 1152px) {
    .home-layout {
      grid-template-columns: minmax(320px, 420px) calc(8 * var(--tile-unit) + 7 * var(--tile-gap));
      align-items: start;
    }
  }
  .home-intro p {
    margin: 0;
  }
  /* The loud tile: the numeral at 72px, a label bottom left. */
  .tile-numeral {
    --numeral-size: 4.5rem;
    margin: var(--space-1) 0 0;
    white-space: nowrap;
  }
  /* 38% unit (the guide's loud tile figure) so "active" fits 112px. */
  .tile-numeral :global(small) {
    font-size: 0.36em;
    margin-left: 0.12em;
  }
  .tile-note {
    margin: auto 0 0;
  }
</style>
