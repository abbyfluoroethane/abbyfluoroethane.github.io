---
import Base from '../layouts/Base.astro';
import LastfmWidget from '../components/LastfmWidget.astro';
import { getGuestbook, getNav, getPosts, getProjects } from '../lib/collections';
import Tile from '../components/tiles/Tile.astro';
import TileGrid from '../components/tiles/TileGrid.astro';
import TileLive from '../components/tiles/TileLive.astro';
import { excerpt, truncateWords } from '../lib/format';

const nav = await getNav();
const latestPost = (await getPosts())[0];
const latestPostDesc = latestPost
  ? truncateWords(latestPost.data.summary ?? excerpt(latestPost.body), 20, '')
  : '';
const projects = await getProjects();
const activeProjects = projects.filter((p) => p.data.status === 'active').length;
// Oldest featured project first, so the cycle starts with the longest-running
// one. Only active projects are featured.
const featuredProjects = projects
  .filter((p) => p.data.featured && p.data.status === 'active')
  .reverse();
const recentEntries = (await getGuestbook()).slice(0, 3);
---

<Base appName="haii, i'm abby :3">
  <div class="home-layout">
    <div class="home-intro">
      <p class="muted">welcome to my little corner of the internet. i build things that go to space, break things that stay on earth, and occasionally muse about my thoughts.</p>
    </div>

    <TileGrid>
      {nav.map((s) => {
        const tile = { size: s.size, fill: s.fill, href: s.url, label: s.name };
        if (s.name === 'blog') return (
          <Tile {...tile} live>
            <TileLive>
              {latestPost && (
                <>
                  <p class="tile-live-title tile-clamp">{latestPost.data.title}</p>
                  <p class="tile-live-desc blog-desc">{latestPostDesc}</p>
                </>
              )}
            </TileLive>
          </Tile>
        );
        if (s.name === 'music') return (
          <Tile {...tile} live art>
            <TileLive strip><LastfmWidget id="lastfm-tile" count={1} tile={true} /></TileLive>
          </Tile>
        );
        // The one loud tile of the view: the numeral, then the featured
        // projects taking turns.
        if (s.name === 'projects') return (
          <Tile {...tile} loud live>
            <p class="numeral tile-numeral">{activeProjects}<small>active</small></p>
            <TileLive cycle>
              <div class="tile-cycle-viewport">
                {featuredProjects.map((p, i) => (
                  <div class={`tile-cycle-item${i === 0 ? ' is-active' : ''}`}>
                    <p class="tile-live-title">{p.data.title}</p>
                    <p class="tile-live-years data">{p.data.date.getUTCFullYear()} – present</p>
                    <p class="tile-live-desc" style="--tile-lines: 3">{p.data.description}</p>
                  </div>
                ))}
              </div>
            </TileLive>
          </Tile>
        );
        if (s.name === 'guestbook') return (
          <Tile {...tile} live>
            <TileLive cycle>
              <div class="tile-cycle-viewport">
                {recentEntries.map((e, i) => (
                  <div class={`tile-cycle-item${i === 0 ? ' is-active' : ''}`}>
                    <p class="tile-live-title">{e.name}</p>
                    <p class="tile-live-desc" style="--tile-lines: 4">{e.message}</p>
                  </div>
                ))}
              </div>
            </TileLive>
          </Tile>
        );
        return <Tile {...tile} external={s.url.startsWith('http')} />;
      })}
    </TileGrid>
  </div>
</Base>

<style>
  /* The intro and the tile field sit side by side when the row holds both:
     120px margin + 320px intro + 64px gap + 632px tiles + 64px right
     padding is 1200. Narrower, they stack. */
  .home-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }
  @media (min-width: 768px) {
    .home-layout {
      gap: var(--space-16);
    }
  }
  @media (min-width: 1200px) {
    .home-layout {
      grid-template-columns: minmax(320px, 420px) max-content;
      align-items: start;
    }
  }
  .home-intro p {
    margin: 0;
  }
  /* The loud tile: a 96px numeral with its unit at 40%. */
  .tile-numeral {
    margin: var(--space-2) 0 var(--space-3);
    white-space: nowrap;
  }
  .blog-desc {
    --tile-lines: 2;
  }
  /* Wide tiles on a phone are the full width and half as tall: room for
     three lines. */
  @media (max-width: 767px) {
    .blog-desc {
      --tile-lines: 3;
    }
  }
  .tile-clamp {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
