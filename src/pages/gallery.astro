---
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { getImage, Image } from 'astro:assets';
import Base from '../layouts/Base.astro';

const photos = (await getCollection('gallery')).sort((a, b) => a.data.order - b.data.order);

// Photos sharing a caption form one group, in file order. The group heading
// carries the caption, so the tiles carry only the alt text. The first row is
// above the fold, so it loads eagerly. The link opens a large version.
const groups: { name: string; items: { image: ImageMetadata; full: string; alt: string; loading: 'eager' | 'lazy' }[] }[] = [];
let n = 0;
for (const { data } of photos) {
  const name = data.caption ?? data.alt;
  let group = groups[groups.length - 1];
  if (!group || group.name !== name) {
    group = { name, items: [] };
    groups.push(group);
  }
  group.items.push({
    image: data.image,
    full: (await getImage({ src: data.image, width: Math.min(data.image.width, 2400) })).src,
    alt: data.alt,
    loading: n++ < 4 ? 'eager' : 'lazy',
  });
}
---
<Base title="gallery">
  {groups.map((group, g) => (
    <section class="gallery-group" aria-labelledby={`group-${g}`}>
      <p class="overline muted">{String(g + 1).padStart(2, '0')} · {group.items.length} {group.items.length === 1 ? 'photo' : 'photos'}</p>
      <h2 class="heading" id={`group-${g}`}>{group.name}</h2>
      <div class="gallery-grid">
        {group.items.map((item) => (
          <a class="gallery-item" href={item.full} target="_blank" rel="noopener">
            <Image src={item.image} alt={item.alt} widths={[400, 800]} sizes="(min-width: 768px) 25vw, 50vw" loading={item.loading} />
          </a>
        ))}
      </div>
    </section>
  ))}
</Base>

<style>
  .gallery-group {
    margin-top: var(--space-8);
  }
  .gallery-group > p,
  .gallery-group > h2 {
    margin: 0;
  }
  .gallery-grid {
    display: grid;
    /* 180px is the smallest square that still shows a photo clearly. */
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: var(--tile-gap);
    margin-top: var(--space-4);
  }
  .gallery-item {
    display: block;
    aspect-ratio: 1 / 1;
    background: var(--mantle);
  }
  /* Hover and press fill, as on the home tiles. */
  .gallery-item:hover {
    background: var(--hover);
  }
  .gallery-item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    margin: 0;
  }
  .gallery-item:hover img {
    opacity: 0.85;
  }
</style>
