---
// The blog as a panorama: the newest post is the hero, set bigger than the
// page header; older posts sit in one column per year under a giant faded
// year numeral, like the Zune panorama's section titles.
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/collections';
import { excerpt, formatLongDate, readingMinutes, truncateSentences } from '../../lib/format';

const [latest, ...older] = await getPosts();
const years = [...new Set(older.map((p) => p.data.date.getUTCFullYear()))];
const groups = years.map((year) => ({
  year,
  posts: older.filter((p) => p.data.date.getUTCFullYear() === year),
}));
// Three year columns fit the panorama. Older years roll into one plain list
// below, so the columns never wrap or shrink as the blog grows.
const COLUMN_YEARS = 3;
const columns = groups.slice(0, COLUMN_YEARS);
const archive = groups.slice(COLUMN_YEARS).flatMap((g) => g.posts);
const summary = latest.data.summary ?? truncateSentences(excerpt(latest.body), 40);
---
<Base title="blog">
  <article class="hero">
    <h2><a href={`/blog/${latest.id}/`}>{latest.data.title}</a></h2>
    <p class="caption">
      <time datetime={latest.data.date.toISOString()}>{formatLongDate(latest.data.date)}</time>
      · {readingMinutes(latest.body)} min read
    </p>
    <p class="summary">{summary}</p>
  </article>

  <div class="years">
    {columns.map(({ year, posts }) => (
      <section aria-labelledby={`year-${year}`}>
        <h2 id={`year-${year}`} class="year">{year}</h2>
        <ul>
          {posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              <time class="caption" datetime={post.data.date.toISOString()}>{formatLongDate(post.data.date)}</time>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  {archive.length > 0 && (
    <section class="archive" aria-labelledby="archive">
      <h2 id="archive">archive</h2>
      <ul>
        {archive.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            <time class="caption" datetime={post.data.date.toISOString()}>{formatLongDate(post.data.date)}</time>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>

<style>
  .hero {
    margin-top: var(--space-8);
    margin-bottom: var(--space-16);
  }
  .hero h2 {
    max-width: 14em;
    margin: 0 0 var(--space-4);
    font-size: var(--type-display);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .hero h2 a {
    color: var(--ctp-text);
  }
  .hero h2 a:hover {
    color: var(--ctp-pink);
    text-decoration: none;
  }
  .caption {
    margin: 0;
    font-size: var(--type-caption);
    font-weight: var(--type-caption-weight);
    line-height: var(--type-caption-leading);
    color: var(--ctp-subtext0);
  }
  .hero .caption {
    margin-bottom: var(--space-3);
  }
  .summary {
    max-width: 38em;
    margin: 0;
    font-size: var(--type-item);
    line-height: var(--type-item-leading);
    color: var(--ctp-subtext1);
  }

  /* Phone and tablet: columns stack. Desktop: the (at most three) year
     columns side by side. */
  .years {
    display: grid;
    gap: var(--space-12) var(--space-16);
  }
  @media (min-width: 1000px) {
    .years {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .years section {
    container-type: inline-size; /* the numeral sizes to its column */
  }
  .year {
    /* A decoration size outside the ramp: the numeral is a landmark. It
       never wraps, and it shrinks to fit a narrow column: four digits of
       Selawik Light are about 1.95em wide, so 45cqi leaves a small margin. */
    margin: 0 0 var(--space-4);
    overflow: hidden;
    white-space: nowrap;
    font-size: min(clamp(5rem, 11vw, 9rem), 45cqi); /* 80-144px */
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--ctp-surface1);
  }
  @media (prefers-color-scheme: dark) {
    .year {
      color: var(--ctp-surface0);
    }
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    max-width: none;
    margin-bottom: var(--space-6);
  }
  li a {
    display: block;
    font-size: var(--type-item);
    line-height: var(--type-item-leading);
    color: var(--ctp-text);
  }
  li a:hover {
    color: var(--ctp-pink);
    text-decoration: none;
  }
  li .caption {
    display: block;
    margin-top: var(--space-1);
  }

  /* The archive: a plain list, the 80px group gap above it. */
  .archive {
    margin-top: var(--space-16);
  }
  .archive h2 {
    margin: 0 0 var(--space-4);
  }
</style>
