---
// The blog as a panorama: the newest post is the hero, set as a quiet Light
// title; older posts sit in one column per year under a mono year overline.
// The title is the link, the date is data, the summary is muted body text.
// The view has no loud element: the newest post title is quiet.
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/collections';
import { excerpt, formatDate, formatMinutes, readingMinutes, truncateSentences } from '../../lib/format';

const [latest, ...older] = await getPosts();
const years = [...new Set(older.map((p) => p.data.date.getUTCFullYear()))];
const groups = years.map((year) => ({
  year,
  posts: older.filter((p) => p.data.date.getUTCFullYear() === year),
}));
// Three year columns fit the panorama. Older years roll into one plain list
// below, so the columns never wrap or shrink as the blog grows.
const COLUMN_YEARS = 3;
const columns = groups.slice(0, COLUMN_YEARS);
const archive = groups.slice(COLUMN_YEARS).flatMap((g) => g.posts);
const summaryOf = (post: typeof latest) =>
  post.data.summary ?? truncateSentences(excerpt(post.body), 28);
---
<Base title="blog">
  <article class="latest">
    <a class="row" href={`/blog/${latest.id}/`}>
      <p class="fk-overline fk-muted">
        <time datetime={formatDate(latest.data.date)}>{formatDate(latest.data.date)}</time>
        · {formatMinutes(readingMinutes(latest.body))}
      </p>
      <h2 class="fk-title">{latest.data.title}</h2>
      <p class="summary">{summaryOf(latest)}</p>
    </a>
  </article>

  <div class="years">
    {columns.map(({ year, posts }) => (
      <section aria-labelledby={`year-${year}`}>
        <h2 id={`year-${year}`} class="fk-overline">{year}</h2>
        <ul>
          {posts.map((post) => (
            <li>
              <a class="row" href={`/blog/${post.id}/`}>
                <time class="fk-data fk-muted" datetime={formatDate(post.data.date)}>{formatDate(post.data.date)}</time>
                <span class="name">{post.data.title}</span>
                <span class="summary">{summaryOf(post)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  {archive.length > 0 && (
    <section class="archive" aria-labelledby="archive">
      <h2 id="archive" class="fk-overline">archive</h2>
      <ul>
        {archive.map((post) => (
          <li>
            <a class="row" href={`/blog/${post.id}/`}>
              <time class="fk-data fk-muted" datetime={formatDate(post.data.date)}>{formatDate(post.data.date)}</time>
              <span class="name">{post.data.title}</span>
              <span class="summary">{summaryOf(post)}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>

<style>
  /* A row is one link: no underline, the hover fill is the affordance. The
     text stays text color on hover, and muted parts switch to it. */
  .row {
    display: block;
    padding: var(--fk-space-3) var(--fk-space-4);
    text-decoration: none;
    color: var(--fk-text);
  }
  .row:hover {
    background-color: var(--fk-hover);
  }
  .row:hover .fk-muted,
  .row:hover .fk-overline,
  .row:hover .summary,
  .row:hover time {
    color: var(--fk-text);
  }
  .summary {
    display: block;
    max-width: 66ch;
    margin: var(--fk-space-1) 0 0;
    font-size: var(--fk-body-size);
    line-height: var(--fk-body-leading);
    color: var(--fk-muted);
  }
  .row > time {
    display: block;
  }
  .name {
    display: block;
    margin-top: var(--fk-space-1);
    font-size: var(--fk-subheading-size);
    font-weight: 600;
    line-height: var(--fk-subheading-leading);
  }

  /* The latest post sits on the same left edge as the page: the padding of the row
     is pulled back on the sides and the top, so the text lines up with the
     title and starts 24px under the nav, as on every other page. */
  .latest {
    margin: calc(-1 * var(--fk-space-4)) calc(-1 * var(--fk-space-4)) var(--fk-space-12);
  }
  .latest .row {
    padding: var(--fk-space-4);
  }
  .latest .fk-title {
    max-width: 14em;
    margin: var(--fk-space-2) 0 var(--fk-space-3);
  }
  .latest .summary {
    max-width: 52ch;
  }
  .latest p.fk-overline {
    margin: 0;
  }

  /* Phone and tablet: columns stack. Desktop: the (at most three) year
     columns side by side. */
  .years {
    display: grid;
    gap: var(--fk-space-12) var(--fk-space-8);
    margin-inline: calc(-1 * var(--fk-space-4));
  }
  @media (min-width: 1000px) {
    .years {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .years h2,
  .archive h2 {
    margin: 0 0 var(--fk-space-2);
    padding: 0 var(--fk-space-4);
    color: var(--fk-muted);
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    max-width: none;
    margin: 0;
  }

  .archive {
    margin: var(--fk-space-12) calc(-1 * var(--fk-space-4)) 0;
  }
</style>
