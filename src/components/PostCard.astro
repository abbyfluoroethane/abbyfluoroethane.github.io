---
import type { CollectionEntry } from 'astro:content';
import { excerpt, formatLongDate, truncateWords } from '../lib/format';

interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;
const href = `/blog/${post.id}/`;
const description = truncateWords(post.data.summary ?? excerpt(post.body), 40);
---
<!-- The title link is stretched over the row, so no separate "read" link. -->
<div class="card post-card">
  <p class="card-date">{formatLongDate(post.data.date)}</p>
  <h3 class="card-title"><a {href}>{post.data.title}</a></h3>
  <p class="card-desc">{description}</p>
</div>
