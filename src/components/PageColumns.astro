---
// Two-column page body: a meta aside (date, title, links) beside the main
// content. Below 1000px the columns stack.
//
//   <PageColumns asideLast={false} prose={true}>
//     <Fragment slot="aside">...</Fragment>
//     ...main content...
//   </PageColumns>
//
// asideLast: when stacked, show the content first and the aside after it.
// prose: give the content column the `prose` class (markdown typography).
// The aside styles its own headings, paragraphs and lists.
//
// Slotted markup belongs to the page that renders it, so the aside's
// typography classes are reached with :global() under .post-meta.
// Pages may use: .post-date, .post-title, .post-subtitle, .post-attribution,
// .post-tagline, .back-link.
export interface Props {
  asideLast?: boolean;
  prose?: boolean;
}
const { asideLast = false, prose = true } = Astro.props;
---
<div class:list={['post-layout', { 'post-layout--aside-last': asideLast }]}>
  <aside class="post-meta"><slot name="aside" /></aside>
  <article class:list={['post-content', { prose }]}><slot /></article>
</div>

<style>
  /* Mobile: one stacked column. */
  .post-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  /* Grid items default to min-width: auto, so a wide table or long code line
     would widen the column and push the page sideways instead of scrolling
     inside it. */
  .post-meta,
  .post-content {
    min-width: 0;
  }

  .post-meta {
    display: flex;
    flex-direction: column;
  }

  /* flow-root makes the article contain its own floats, so a tall float
     cannot spill past the end of the post. */
  .post-content {
    display: flow-root;
  }

  /* The column is already the width limit, so drop the 62ch cap that .prose
     puts on paragraphs, which would leave the column half empty. The scoped
     selector (class + attribute + element) outranks .prose p by specificity,
     not by load order. */
  .post-content :global(p),
  .post-content :global(li),
  .post-content :global(blockquote) {
    max-width: none;
  }

  /* ---- aside basics (the aside is not .prose, so it sets its own) ---- */
  .post-meta :global(h1) {
    font-size: clamp(2.25rem, 6vw, 3rem); /* same scale as .prose h1 */
    font-weight: 300;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
  }
  .post-meta :global(h2) {
    font-size: clamp(1.75rem, 5vw, 2.25rem); /* same scale as .prose h2 */
    font-weight: 300;
    text-transform: lowercase;
    margin: 2rem 0 0.5rem;
  }
  .post-meta :global(p),
  .post-meta :global(li) {
    max-width: 62ch;
    line-height: 1.6;
  }
  .post-meta :global(.back-link a) {
    text-decoration: none;
  }

  /* Stacked: the back link goes above the title. */
  .post-meta :global(.back-link) {
    order: -1;
    margin: 0 0 1rem;
  }

  /* Stacked: about page reads the bio first, links and contact last. */
  .post-layout--aside-last .post-meta {
    order: 2;
  }
  .post-layout--aside-last .post-content {
    order: 1;
  }

  /* 1000px, not 768px: 120px shell padding + 320px aside floor + 48px gap
     + 448px content + 64px right padding is just under 1000. Below that
     both columns cannot hold their minimum, so they stack. */
  @media (min-width: 1000px) {
    .post-layout {
      grid-template-columns: minmax(320px, 33%) minmax(0, 1fr);
      gap: 3rem;
      align-items: start;
    }
    .post-meta {
      display: block;
      position: sticky;
      top: 3rem;
    }
    .post-layout--aside-last .post-meta,
    .post-layout--aside-last .post-content {
      order: 0;
    }
    .post-meta :global(.back-link) {
      order: 0;
      margin: 1.5rem 0 0;
    }
  }

  @media (min-width: 1200px) {
    .post-layout {
      /* Aside is a quarter, content is half; the last quarter stays empty on
         purpose so the content reads as a true middle column. */
      grid-template-columns: minmax(320px, 25%) minmax(0, 50%);
    }
  }

  /* ---- aside typography ---- */
  .post-meta :global(.post-date) {
    color: var(--ctp-subtext0);
    font-size: 0.9375rem;
    text-transform: lowercase;
    margin: 0 0 0.375rem;
  }
  .post-meta :global(.post-title) {
    margin: 0;
  }
  /* Short line under the title (resume), quieter than the title. */
  .post-meta :global(.post-tagline) {
    margin: 0.75rem 0 0;
    color: var(--ctp-subtext0);
  }
  /* Standfirst: large and light enough to read as part of the headline. It
     is an <h2>, so undo the lowercase section-heading style; a standfirst is
     prose and keeps its capitals. */
  .post-meta :global(.post-subtitle) {
    margin: 0.625rem 0 0;
    font-size: 1.125rem;
    font-weight: 300;
    line-height: 1.45;
    text-transform: none;
    color: var(--ctp-subtext0);
  }
  /* Credit line: small chrome text like a tile label, but keeps its case. */
  .post-meta :global(.post-attribution) {
    margin: 0.875rem 0 0;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--ctp-overlay1);
  }

  /* ---- embedded fediverse post in markdown (content from src/content) ---- */
  .post-content :global(.fedi-embed) {
    margin: 1.5rem 0;
    padding: 1rem 1.25rem;
    background: var(--ctp-mantle);
    border-left: 3px solid var(--ctp-lavender);
  }
  .post-content :global(.fedi-embed-label) {
    margin: 0 0 0.25rem;
    font-size: 0.8125rem;
    text-transform: lowercase;
    color: var(--ctp-subtext0);
  }
  .post-content :global(.fedi-embed a) {
    word-break: break-all;
  }
</style>
