---
// Two-column page body: a meta aside (date, title, links) beside the main
// content. Below 1000px the columns stack.
//
//   <PageColumns asideLast={false} prose={true}>
//     <Fragment slot="aside">...</Fragment>
//     ...main content...
//   </PageColumns>
//
// asideLast: when stacked, show the content first and the aside after it.
// prose: give the content column the `prose` class (markdown typography).
// The aside styles its own headings, paragraphs and lists.
//
// Slotted markup belongs to the page that renders it, so the aside's
// typography classes are reached with :global() under .post-meta.
// Pages may use: .post-date, .post-title, .post-tagline.
export interface Props {
  asideLast?: boolean;
  prose?: boolean;
}
const { asideLast = false, prose = true } = Astro.props;
---
<div class:list={['post-layout', { 'post-layout--aside-last': asideLast }]}>
  <aside class="post-meta"><slot name="aside" /></aside>
  <article class:list={['post-content', { prose }]}><slot /></article>
</div>

<style>
  /* Mobile: one stacked column. */
  .post-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  /* Grid items default to min-width: auto, so a wide table or long code line
     would widen the column and push the page sideways instead of scrolling
     inside it. */
  .post-meta,
  .post-content {
    min-width: 0;
  }

  .post-meta {
    display: flex;
    flex-direction: column;
  }

  /* flow-root makes the article contain its own floats, so a tall float
     cannot spill past the end of the post. */
  .post-content {
    display: flow-root;
  }

  /* ---- aside basics ---- */
  .post-meta :global(h2) {
    margin: var(--space-8) 0 var(--space-2);
  }

  /* Stacked: about page reads the bio first, links and contact last. */
  .post-layout--aside-last .post-meta {
    order: 2;
  }
  .post-layout--aside-last .post-content {
    order: 1;
  }

  /* 1000px, not 768px: 120px shell padding + 320px aside floor + 60px gap
     + 448px content + 64px right padding is just under 1000. Below that
     both columns cannot hold their minimum, so they stack. */
  @media (min-width: 1000px) {
    .post-layout {
      /* off-grid: 320px is the narrowest aside that holds a title */
      grid-template-columns: minmax(320px, 33%) minmax(0, 1fr);
      gap: var(--space-12);
      align-items: start;
    }
    .post-meta {
      display: block;
      position: sticky;
      top: var(--space-8);
    }
    .post-layout--aside-last .post-meta,
    .post-layout--aside-last .post-content {
      order: 0;
    }
  }

  @media (min-width: 1200px) {
    .post-layout {
      /* Aside is a quarter, content is half; the last quarter stays empty on
         purpose so the content reads as a true middle column. */
      grid-template-columns: minmax(320px, 25%) minmax(0, 50%); /* off-grid: 320px aside floor */
      gap: var(--space-16);
    }
  }

  /* ---- aside metadata ---- */
  .post-meta :global(.post-date) {
    margin: 0 0 var(--space-1);
    font-size: var(--type-caption);
    line-height: var(--type-caption-leading);
    text-transform: lowercase;
    color: var(--ctp-subtext0);
  }
  /* h1 from global.css is already the title step; h2 on the resume needs it. */
  .post-meta :global(.post-title) {
    margin: 0;
    font-size: var(--type-title-lg);
    font-weight: var(--type-title-lg-weight);
    line-height: var(--type-title-lg-leading);
  }
  /* Short line under the name (resume). */
  .post-meta :global(.post-tagline) {
    margin: var(--space-3) 0 0;
    font-size: var(--type-item);
    font-weight: var(--type-item-weight);
    line-height: var(--type-item-leading);
    color: var(--ctp-subtext0);
  }
</style>
