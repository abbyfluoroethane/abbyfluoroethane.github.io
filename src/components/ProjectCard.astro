---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { title, status, description, date, external_url, url_text, article } = project.data;
---
<div class="card project-card">
  <div class="card-head">
    <h3 class="card-title">{title}</h3>
    <span class={`status-pill status-${status}`}>{status}</span>
  </div>
  <p class="card-desc">{description}</p>
  <div class="card-meta">
    <span class="card-date">{date.getUTCFullYear()}</span>
    {external_url && <a class="card-link" href={external_url}>{url_text ?? 'external link'} →</a>}
    {article && <a class="card-link" href={`/projects/${project.id}/`}>read more →</a>}
  </div>
</div>
