---
// One Start screen tile. A navigation tile is an overline only, bottom left.
// A content or live tile holds an overline (top left), then slot content.
// Every tile is filled with one of the theme's tile colors, the same in
// both modes, with light text on it. A navigation tile may carry a Phosphor icon top
// right, sized in proportion to the tile. An external navigation tile shows
// its ↗ there instead. The overline always names the tile, so the icon is
// never alone.
import Icon from '../Icon.astro';
import type { IconName } from '../Icon.astro';
import type { TileColor } from '../../lib/palette';

interface Props {
  size?: 'square' | 'wide' | 'large';
  /** A tile color name (src/lib/palette.ts). */
  color?: TileColor;
  /** Phosphor icon, top right. Decorative: the overline names the tile. */
  icon?: IconName;
  href: string;
  /** The overline text. */
  label: string;
  /** Navigation tile: the overline only, bottom left. */
  nav?: boolean;
  /** The link leaves the site: a ↗, top right on a navigation tile, after
      the overline otherwise. */
  external?: boolean;
  /** Slot content is live: src/scripts/lastfm.ts looks for `.tile-live-tile`. */
  live?: boolean;
  /** Album art fills the tile under a tint; the text sits on the art. */
  art?: boolean;
}
const { size = 'square', color = 'pink', icon, href, label, nav = false, external = false, live = false, art = false } = Astro.props;

// The fill comes from the fluorokit theme (--fk-tile-<name>).
const accent = `var(--fk-tile-${color})`;
---
<a
  class:list={['tile', { 'tile-live-tile': live, 'tile-nav': nav, 'has-strip': art }]}
  data-size={size}
  href={href}
  style={`--tile-color: ${accent}`}
  {...external ? { rel: 'noopener' } : {}}
>
  {icon && <Icon name={icon} class="tile-icon" />}
  {external && nav && <span class="tile-arrow" aria-hidden="true">↗</span>}
  <span class="fk-overline tile-label">{label}{external && !nav && <span aria-hidden="true"> ↗</span>}{external && <span class="fk-sr-only"> (external site)</span>}</span>
  <slot />
</a>

<style>
  .tile {
    --tile-fill: var(--tile-color);
    /* Hover and pressed: the accent darkened toward Mocha crust. */
    --tile-hover: color-mix(in srgb, var(--tile-color) 85%, #11111b);
    /* Text on a tile is the theme's tile text, the same in both modes.
       Everything inside a tile reads --fk-text and --fk-muted, so both are
       set here. The skeleton reads --fk-raised: a wash of the text color on
       the fill. */
    --fk-text: var(--fk-tile-text);
    --fk-muted: var(--fk-tile-text);
    --fk-raised: color-mix(in srgb, var(--fk-tile-text) 25%, var(--tile-color));
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: var(--fk-space-2) var(--fk-space-3);
    background-color: var(--tile-fill);
    color: var(--fk-text); /* always text on a tile, never muted */
    text-decoration: none;
    cursor: pointer;
    user-select: none;
    overflow: hidden;
    transition: transform 0.1s ease;
    animation: fk-enter var(--fk-enter-duration) var(--fk-ease-metro) backwards; /* delay set by home.ts */
    /* The icon is 16% of the tile's height, from the grid unit TileGrid
       sets: 24px on a 152px tile, 50px on a 312px one, and in proportion
       on a phone. */
    --tile-icon: calc(var(--tile-unit) * 0.16);
  }
  .tile[data-size='large'] {
    --tile-icon: calc((2 * var(--tile-unit) + var(--fk-tile-gap)) * 0.16);
  }
  /* Top right, on the overline's top edge, above the album art and tint. */
  .tile :global(.tile-icon) {
    position: absolute;
    top: var(--fk-space-2);
    right: var(--fk-space-3);
    z-index: 2;
    width: var(--tile-icon);
    height: var(--tile-icon);
    pointer-events: none;
  }
  /* The ↗ of an external navigation tile: the Plex glyph at the icon size,
     in the icon's place. */
  .tile-arrow {
    position: absolute;
    top: var(--fk-space-2);
    right: var(--fk-space-3);
    z-index: 2;
    font-family: var(--fk-font-sans);
    font-size: var(--tile-icon);
    font-weight: 400;
    line-height: 1;
    pointer-events: none;
  }
  .tile-nav {
    justify-content: flex-end;
  }
  .tile[data-size='wide'] {
    grid-column: span 2;
  }
  .tile[data-size='large'] {
    grid-column: span 2;
    grid-row: span 2;
    padding: var(--fk-space-3);
  }
  /* Hover and pressed: the same fill. The tilt stays from the Metro base. */
  .tile:hover,
  .tile:active {
    --tile-fill: var(--tile-hover);
    text-decoration: none;
  }
  .tile:active {
    transform: scale(0.97);
  }
  .tile:focus-visible {
    outline: 2px solid var(--fk-focus);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .tile {
      animation: none;
      transition: none;
    }
  }

  .tile-label {
    position: relative;
    font-weight: 600; /* heavier than the 500 overline, to hold on the accent */
    z-index: 2;
    flex: none; /* the body clips first, never the overline */
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Tile with album art (the music tile). The art is inserted by
     src/scripts/lastfm.ts as `.tile-art` and fills the whole tile, behind
     everything. A flat veil of Mocha crust darkens the cover so the light
     overline and caption read on it, in both themes. 60% keeps the text at
     about 4.5:1 on a white cover. Hover deepens the veil. With no cover the
     tile shows its accent. */
  .tile.has-strip {
    --art-veil: color-mix(in srgb, #11111b 60%, transparent);
  }
  /* Over a loaded cover the veil is dark, so the text is light there in
     each theme. */
  .tile.has-strip:has(:global(.art-layer.is-loaded)) {
    --fk-text: #eff1f5;
    --fk-muted: #eff1f5;
  }
  .tile.has-strip:hover,
  .tile.has-strip:active {
    --tile-fill: var(--tile-color);
    --art-veil: color-mix(in srgb, #11111b 70%, transparent);
  }
  .tile-live-tile :global(.tile-art) {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-color: var(--tile-fill);
    color: var(--fk-text);
  }
  /* Only over a loaded cover: with no art the tile keeps the plain accent
     fill of the other tiles. */
  .tile-live-tile :global(.tile-art:has(.art-layer.is-loaded))::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
    background-color: var(--art-veil);
    pointer-events: none;
  }
</style>
