---
// One Start screen tile. A navigation tile is an overline only, bottom left.
// A content or live tile holds an overline (top left), then slot content.
// Every tile is filled with a Catppuccin Latte accent, in both themes, with
// light text on it. A navigation tile may carry a Phosphor icon top
// right, sized in proportion to the tile. An external navigation tile shows
// its ↗ there instead. The overline always names the tile, so the icon is
// never alone.
// The loud tile (at most one per view) adds a 6px energy bar across its top
// edge, then an overline, a numeral, a label and an optional live block.
import Icon from '../Icon.astro';
import type { IconName } from '../Icon.astro';

interface Props {
  size?: 'square' | 'wide' | 'large';
  /** A Catppuccin Latte accent name (LATTE below). */
  color?: string;
  /** Phosphor icon, top right. Decorative: the overline names the tile. */
  icon?: IconName;
  href: string;
  /** The overline text. */
  label: string;
  /** Navigation tile: the overline only, bottom left. */
  nav?: boolean;
  /** The one loud tile of the view: energy bar on the top edge. */
  loud?: boolean;
  /** The link leaves the site: a ↗, top right on a navigation tile, after
      the overline otherwise. */
  external?: boolean;
  /** Slot content is live: src/scripts/lastfm.ts looks for `.tile-live-tile`. */
  live?: boolean;
  /** Album art fills the tile under a tint; the text sits on the art. */
  art?: boolean;
}
const { size = 'square', color = 'pink', icon, href, label, nav = false, loud = false, external = false, live = false, art = false } = Astro.props;

// The Latte accents. They stay Latte in Mocha too, so the light text on a
// tile has the same contrast in both themes.
const LATTE: Record<string, string> = {
  rosewater: '#dc8a78',
  flamingo: '#dd7878',
  pink: '#ea76cb',
  mauve: '#8839ef',
  red: '#d20f39',
  maroon: '#e64553',
  peach: '#fe640b',
  yellow: '#df8e1d',
  green: '#40a02b',
  teal: '#179299',
  sky: '#04a5e5',
  sapphire: '#209fb5',
  blue: '#1e66f5',
  lavender: '#7287fd',
};
const accent = LATTE[color] ?? LATTE.pink;
---
<a
  class:list={['tile', { 'tile-live-tile': live, 'tile-nav': nav, loud, 'has-strip': art }]}
  data-size={size}
  href={href}
  style={`--tile-color: ${accent}`}
  {...external ? { rel: 'noopener' } : {}}
>
  {icon && <Icon name={icon} class="tile-icon" />}
  {external && nav && <span class="tile-arrow" aria-hidden="true">↗</span>}
  <span class="overline tile-label">{label}{external && !nav && <span aria-hidden="true"> ↗</span>}{external && <span class="sr-only"> (external site)</span>}</span>
  <slot />
</a>

<style>
  .tile {
    --tile-fill: var(--tile-color);
    /* Hover and pressed: the accent darkened toward Mocha crust. */
    --tile-hover: color-mix(in srgb, var(--tile-color) 85%, #11111b);
    /* Text on an accent is Latte base in both themes. Everything inside a
       tile reads --text and --muted, so both are set here. The skeleton
       reads --raised: a light wash of the accent. */
    --text: #eff1f5;
    --muted: #eff1f5;
    --raised: color-mix(in srgb, #eff1f5 25%, var(--tile-color));
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: var(--space-2) var(--space-3);
    background-color: var(--tile-fill);
    color: var(--text); /* always text on a tile, never muted */
    text-decoration: none;
    cursor: pointer;
    user-select: none;
    overflow: hidden;
    transition: transform 0.1s ease;
    animation: metro-enter 0.7s var(--ease-metro) backwards; /* delay set by home.ts */
    /* The icon is 16% of the tile's height, from the grid unit TileGrid
       sets: 24px on a 152px tile, 50px on a 312px one, and in proportion
       on a phone. */
    --tile-icon: calc(var(--tile-unit) * 0.16);
  }
  .tile[data-size='large'] {
    --tile-icon: calc((2 * var(--tile-unit) + var(--tile-gap)) * 0.16);
  }
  /* Top right, on the overline's top edge, above the album art and tint. */
  .tile :global(.tile-icon) {
    position: absolute;
    top: var(--space-2);
    right: var(--space-3);
    z-index: 2;
    width: var(--tile-icon);
    height: var(--tile-icon);
    pointer-events: none;
  }
  /* The ↗ of an external navigation tile: the Plex glyph at the icon size,
     in the icon's place. */
  .tile-arrow {
    position: absolute;
    top: var(--space-2);
    right: var(--space-3);
    z-index: 2;
    font-family: var(--font-sans);
    font-size: var(--tile-icon);
    font-weight: 400;
    line-height: 1;
    pointer-events: none;
  }
  .tile.loud :global(.tile-icon) {
    top: calc(var(--bar-edge) + var(--space-3));
  }
  .tile-nav {
    justify-content: flex-end;
  }
  .tile[data-size='wide'] {
    grid-column: span 2;
  }
  .tile[data-size='large'] {
    grid-column: span 2;
    grid-row: span 2;
    padding: var(--space-3);
  }
  /* Hover and pressed: the same fill. The tilt stays from the Metro base. */
  .tile:hover,
  .tile:active {
    --tile-fill: var(--tile-hover);
    text-decoration: none;
  }
  .tile:active {
    transform: scale(0.97);
  }
  .tile:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .tile {
      animation: none;
      transition: none;
    }
  }

  .tile-label {
    position: relative;
    font-weight: 600; /* heavier than the 500 overline, to hold on the accent */
    z-index: 2;
    flex: none; /* the body clips first, never the overline */
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* The loud tile: a bar on the top edge, decoration only. */
  .tile.loud {
    padding-top: calc(var(--bar-edge) + var(--space-3));
  }
  .tile.loud::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: var(--bar-edge);
    background: var(--energy-bar);
  }

  /* Tile with album art (the music tile). The art is inserted by
     src/scripts/lastfm.ts as `.tile-art` and fills the whole tile, behind
     everything. A flat veil of Mocha crust darkens the cover so the light
     overline and caption read on it, in both themes. 60% keeps the text at
     about 4.5:1 on a white cover. Hover deepens the veil. With no cover the
     tile shows its accent. */
  .tile.has-strip {
    --art-veil: color-mix(in srgb, #11111b 60%, transparent);
  }
  .tile.has-strip:hover,
  .tile.has-strip:active {
    --tile-fill: var(--tile-color);
    --art-veil: color-mix(in srgb, #11111b 70%, transparent);
  }
  .tile-live-tile :global(.tile-art) {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-color: var(--tile-fill);
    color: var(--text);
  }
  /* Only over a loaded cover: with no art the tile keeps the plain accent
     fill of the other tiles. */
  .tile-live-tile :global(.tile-art:has(.art-layer.is-loaded))::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
    background-color: var(--art-veil);
    pointer-events: none;
  }
</style>
