---
// One Start screen tile. A navigation tile is an overline only, bottom left.
// A content or live tile holds an overline (top left), then slot content.
// Never an icon alone. Fills are raised and mantle only. The loud tile (at
// most one per view) is raised with a 6px energy bar across its top edge,
// then an overline, a numeral, a label and an optional live block.
interface Props {
  size?: 'square' | 'wide' | 'large';
  fill?: 'raised' | 'mantle';
  href: string;
  /** The overline text. */
  label: string;
  /** Navigation tile: the overline only, bottom left. */
  nav?: boolean;
  /** The one loud tile of the view: energy bar on the top edge. */
  loud?: boolean;
  /** The link leaves the site: the overline gets a ↗. */
  external?: boolean;
  /** Slot content is live: src/scripts/lastfm.ts looks for `.tile-live-tile`. */
  live?: boolean;
  /** Album art fills the tile; the overline sits on a solid strip. */
  art?: boolean;
}
const { size = 'square', fill = 'raised', href, label, nav = false, loud = false, external = false, live = false, art = false } = Astro.props;
---
<a
  class:list={['tile', { 'tile-live-tile': live, 'tile-nav': nav, loud, 'has-strip': art }]}
  data-size={size}
  data-fill={loud ? 'raised' : fill}
  href={href}
  {...external ? { rel: 'noopener' } : {}}
>
  <span class="overline tile-label">{label}{external && <span aria-hidden="true"> ↗</span>}{external && <span class="sr-only"> (external site)</span>}</span>
  <slot />
</a>

<style>
  .tile {
    --tile-fill: var(--raised);
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: var(--space-2) var(--space-3);
    background-color: var(--tile-fill);
    color: var(--text); /* always text on a tile, never muted */
    text-decoration: none;
    cursor: pointer;
    user-select: none;
    overflow: hidden;
    transition: transform 0.1s ease;
    animation: metro-enter 0.7s var(--ease-metro) backwards; /* delay set by home.ts */
  }
  .tile-nav {
    justify-content: flex-end;
  }
  .tile[data-fill='mantle'] {
    --tile-fill: var(--mantle);
  }
  .tile[data-size='wide'] {
    grid-column: span 2;
  }
  .tile[data-size='large'] {
    grid-column: span 2;
    grid-row: span 2;
    padding: var(--space-3);
  }
  /* Hover and pressed: the same fill. The tilt stays from the Metro base. */
  .tile:hover,
  .tile:active {
    --tile-fill: var(--hover);
    text-decoration: none;
  }
  .tile:active {
    transform: scale(0.97);
  }
  .tile:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .tile {
      animation: none;
      transition: none;
    }
  }

  .tile-label {
    position: relative;
    z-index: 2;
    flex: none; /* the body clips first, never the overline */
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* The loud tile: a bar on the top edge, decoration only. */
  .tile.loud {
    padding-top: calc(var(--bar-edge) + var(--space-3));
  }
  .tile.loud::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: var(--bar-edge);
    background: var(--energy-bar);
  }

  /* Tile with album art (the music tile). The art is inserted by
     src/scripts/lastfm.ts as `.tile-art`, behind everything. The overline
     sits on a solid strip of the tile fill so it never depends on the
     cover; hover shows on that strip and the art stays. */
  .tile.has-strip {
    padding: 0;
  }
  .tile.has-strip .tile-label {
    padding: var(--space-2) var(--space-3);
    background-color: var(--tile-fill);
  }
  .tile-live-tile :global(.tile-art) {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-color: var(--tile-fill);
    color: var(--text);
  }
  .tile.has-strip:hover,
  .tile.has-strip:active {
    --tile-fill: var(--raised);
  }
  .tile.has-strip:hover .tile-label,
  .tile.has-strip:active .tile-label,
  .tile.has-strip:hover :global(.tile-live),
  .tile.has-strip:active :global(.tile-live) {
    background-color: var(--hover);
  }
</style>
