---
// Body area of a live tile, under the overline. Its children come from the
// page (slot) or from src/scripts/lastfm.ts, so they are styled with :global
// under this scoped parent. Text is always the text token, full opacity.
interface Props {
  /** Pin to the bottom of the tile on a solid strip (the music tile). */
  strip?: boolean;
}
const { strip = false } = Astro.props;
---
<div class:list={['tile-live', { strip }]}><slot /></div>

<style>
  .tile-live {
    position: relative;
    z-index: 1;
    min-width: 0;
    margin-top: var(--space-1);
    color: var(--text);
  }
  .tile-live :global(p) {
    margin: 0;
  }
  .tile-live :global(.tile-live-title) {
    font-size: var(--small-size);
    font-weight: 600;
    line-height: var(--small-leading);
  }
  .tile-live :global(.tile-live-desc) {
    font-size: var(--small-size);
    font-weight: 400;
    line-height: var(--small-leading);
    display: -webkit-box;
    -webkit-line-clamp: var(--tile-lines, 1);
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* One line with an ellipsis (the blog tile). */
  .tile-live :global(.is-oneline) {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;
  }

  /* Music: a solid strip pinned to the bottom, over the cover. The
     lastfm.ts label and album lines stay out; title and artist stay. */
  .tile-live.strip {
    position: absolute;
    inset: auto 0 0 0;
    margin: 0;
    padding: var(--space-2) var(--space-3);
    background-color: var(--raised);
  }
  .tile-live.strip :global(.tile-live-label),
  .tile-live.strip :global(.tile-live-album) {
    display: none;
  }
  .tile-live.strip :global(.tile-live-title),
  .tile-live.strip :global(.tile-live-artist) {
    opacity: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tile-live.strip :global(.tile-live-artist) {
    font-size: var(--label-size);
    font-weight: 400;
    line-height: var(--label-leading);
  }
  .tile-live :global(.lastfm-widget-tile) {
    margin: 0;
  }
</style>
