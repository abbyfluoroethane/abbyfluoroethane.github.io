---
// Body area of a live tile, under the overline. Its children come from the
// page (slot) or from src/scripts/lastfm.ts, so they are styled with :global
// under this scoped parent. Text is always the text token, full opacity.
interface Props {
  /** Pin to the bottom of the tile, over the tinted cover (the music tile). */
  strip?: boolean;
  /** Items in a .tile-cycle-viewport take turns; src/scripts/home.ts drives it. */
  cycle?: boolean;
}
const { strip = false, cycle = false } = Astro.props;
---
<div class:list={['tile-live', { strip, 'tile-cycle': cycle }]}><slot /></div>

<style>
  .tile-live {
    position: relative;
    z-index: 1;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    margin-top: var(--space-1);
    color: var(--text);
  }
  .tile-live :global(p) {
    margin: 0;
  }
  .tile-live :global(.tile-live-title) {
    font-size: var(--small-size);
    font-weight: 600;
    line-height: var(--small-leading);
  }
  .tile-live :global(.tile-live-desc) {
    font-size: var(--small-size);
    font-weight: 400;
    line-height: var(--small-leading);
    display: -webkit-box;
    -webkit-line-clamp: var(--tile-lines, 1);
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* One line with an ellipsis (the blog tile). */
  .tile-live :global(.is-oneline) {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;
  }

  /* Music: pinned to the bottom, straight on the tinted cover (Tile.astro
     sets the veil). The lastfm.ts label and album lines stay out; title and
     artist stay. */
  .tile-live.strip {
    position: absolute;
    inset: auto 0 0 0;
    margin: 0;
    padding: var(--space-2) var(--space-3);
  }
  .tile-live.strip :global(.tile-live-label),
  .tile-live.strip :global(.tile-live-album) {
    display: none;
  }
  .tile-live.strip :global(.tile-live-title),
  .tile-live.strip :global(.tile-live-artist) {
    opacity: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tile-live.strip :global(.tile-live-artist) {
    font-size: var(--label-size);
    font-weight: 400;
    line-height: var(--label-leading);
  }
  .tile-live :global(.lastfm-widget-tile) {
    margin: 0;
  }
  .tile-live :global(.tile-live-years) {
    margin: 0 0 var(--space-1);
  }

  /* Cycle: the viewport clips the items. An item rests below it, slides up
     into view when active and up and out when leaving (home.ts). The
     transition sits on the two moving states only, so an item that finishes
     leaving snaps back below without sliding down. */
  .tile-live.tile-cycle {
    flex: 1;
  }
  .tile-live :global(.tile-cycle-viewport) {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .tile-live :global(.tile-cycle-item) {
    position: absolute;
    inset: 0;
    transform: translateY(100%);
  }
  .tile-live :global(.tile-cycle-item.is-active),
  .tile-live :global(.tile-cycle-item.is-leaving) {
    transition: transform 0.55s var(--ease-metro);
  }
  .tile-live :global(.tile-cycle-item.is-active) {
    transform: translateY(0);
  }
  .tile-live :global(.tile-cycle-item.is-leaving) {
    transform: translateY(-100%);
  }
  @media (prefers-reduced-motion: reduce) {
    .tile-live :global(.tile-cycle-item.is-active),
    .tile-live :global(.tile-cycle-item.is-leaving) {
      transition: none;
    }
  }
</style>
