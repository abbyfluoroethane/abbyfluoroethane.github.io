---
// Text area of a live tile. Sits over the tile colour, above the label.
// Its children come from the page (slot) or from src/scripts/lastfm.ts, so
// they are styled with :global under this scoped parent.
interface Props {
  /** Title is clamped to two lines (static caption tiles). */
  caption?: boolean;
  /** Items inside fade in turn; src/scripts/home.ts drives it. */
  cycle?: boolean;
}
const { caption = false, cycle = false } = Astro.props;
---
<div class:list={['tile-live', { caption, 'tile-cycle': cycle }]}><slot /></div>

<style>
  .tile-live {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    right: var(--space-2);
    bottom: var(--space-6); /* room for the tile label */
    z-index: 1; /* above the album art (0), below the label (2) */
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    overflow: hidden;
  }
  .tile-live :global(.lastfm-widget-tile) {
    margin: 0;
  }
  .tile-live :global(.tile-live-label) {
    margin: 0 0 var(--space-1);
    font-size: var(--type-caption);
    line-height: var(--type-caption-leading);
    text-transform: lowercase;
    opacity: 0.75;
  }
  .tile-live :global(.tile-live-title) {
    margin: 0;
    font-size: var(--type-body);
    font-weight: var(--type-title-weight);
    line-height: var(--type-body-leading);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .tile-live.caption :global(.tile-live-title) {
    -webkit-line-clamp: 2;
    margin-bottom: var(--space-1);
  }
  .tile-live :global(.tile-live-artist),
  .tile-live :global(.tile-live-album) {
    margin: 0;
    font-size: var(--type-caption);
    line-height: var(--type-caption-leading);
    opacity: 0.85;
  }
  .tile-live :global(.tile-live-album) {
    opacity: 0.65;
  }
  .tile-live :global(.tile-live-years) {
    margin: 0 0 var(--space-1);
    font-size: var(--type-caption);
    line-height: var(--type-caption-leading);
    opacity: 0.75;
  }
  .tile-live :global(.tile-live-desc) {
    margin: 0;
    font-size: var(--type-caption);
    line-height: var(--type-caption-leading);
    opacity: 0.85;
    display: -webkit-box;
    /* Set by Tile: bigger tiles have room for more lines. */
    -webkit-line-clamp: var(--tile-desc-lines, 3);
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Peek: the viewport clips the items. An item rests below it, slides up
     into view when active and up and out when leaving (home.ts). The
     transition sits on the two moving states only, so an item that finishes
     leaving snaps back below without sliding down. */
  .tile-live :global(.tile-cycle-viewport) {
    position: absolute;
    inset: var(--space-6) 0 0; /* below the label line */
    overflow: hidden;
  }
  .tile-live :global(.tile-cycle-item) {
    position: absolute;
    inset: 0;
    transform: translateY(100%);
  }
  .tile-live :global(.tile-cycle-item.is-active),
  .tile-live :global(.tile-cycle-item.is-leaving) {
    transition: transform 0.55s var(--ease-metro);
  }
  .tile-live :global(.tile-cycle-item.is-active) {
    transform: translateY(0);
  }
  .tile-live :global(.tile-cycle-item.is-leaving) {
    transform: translateY(-100%);
  }
  @media (prefers-reduced-motion: reduce) {
    .tile-live :global(.tile-cycle-item.is-active),
    .tile-live :global(.tile-cycle-item.is-leaving) {
      transition: none;
    }
  }
</style>
