---
// The Start screen field. Tiles go in the default slot.
---
<div class="tile-grid"><slot /></div>
<script>
  import '../../scripts/home';
</script>

<style>
  /* Metro dense packing on the 64 + 8px pitch: `dense` lets a 2×1 fill the
     gap that a 2×2 leaves. Desktop is 8 units wide: 8 × 64 + 7 × 8 = 568px.
     Empty cells are fine; no filler tiles. */
  .tile-grid {
    display: grid;
    grid-auto-flow: dense;
    grid-template-columns: repeat(8, var(--tile-unit));
    grid-auto-rows: var(--tile-unit);
    gap: var(--tile-gap);
  }
  /* Phone: 4 units fill the width inside the 32px gutters, so the unit
     scales up from 64px. 1:1 and 2:1 ratios stay. */
  @media (max-width: 767px) {
    .tile-grid {
      --tile-unit: calc((100vw - 2 * var(--space-8) - 3 * var(--tile-gap)) / 4);
      grid-template-columns: repeat(4, var(--tile-unit));
    }
  }
</style>
