---
// The Start screen field. Tiles go in the default slot.
---
<div class="tile-grid"><slot /></div>
<script>
  import '../../scripts/home';
</script>

<style>
  /* Metro dense packing: `dense` lets a square fill the gap that a wide or
     large tile leaves. Square --tile-1 (152px), wide 312×152, large --tile-2
     (312px), with the 8px tile gutter. auto-fill drops to fewer columns as
     the viewport narrows, up to 4 columns. Empty cells are fine; no filler
     tiles. */
  .tile-grid {
    --tile-unit: var(--tile-1);
    display: grid;
    grid-auto-flow: dense;
    grid-template-columns: repeat(auto-fill, var(--tile-unit));
    grid-auto-rows: var(--tile-unit);
    gap: var(--tile-gap);
    max-width: calc(4 * var(--tile-unit) + 3 * var(--tile-gap));
  }
  /* Phone: three columns that run out to the screen edges, the Windows
     Phone Start screen. Layout exemption 2 of the style guide: below 600px
     the field leaves the 32px page margin and keeps one 8px tile gap to the
     glass on each side. Text keeps the margin. */
  @media (max-width: 599px) {
    .tile-grid {
      --tile-unit: calc((100vw - 4 * var(--tile-gap)) / 3);
      grid-template-columns: repeat(3, var(--tile-unit));
      max-width: none;
      margin-inline: calc(var(--tile-gap) - var(--space-8));
    }
  }
</style>
