---
// A date as data: ISO 8601 in mono, no block and no color. The visible text
// is the ISO date; the datetime attribute carries the same value.
import { formatDate } from '../lib/format';

interface Props {
  date: Date;
}
const { date } = Astro.props;
const iso = formatDate(date);
---
<time class="data" datetime={iso}>{iso}</time>
