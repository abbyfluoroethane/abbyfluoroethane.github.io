---
// The pink Metro block button. Renders a link when given an href, otherwise
// a <button>.
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & HTMLAttributes<'button'>;
const { href, class: className, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---
<Tag class:list={['btn', className]} href={href} {...rest}><slot /></Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    padding: 0 var(--space-4);
    border: 0;
    background: var(--ctp-pink);
    color: var(--ctp-on-accent);
    font-size: var(--type-body);
    font-weight: var(--type-title-weight);
    line-height: var(--type-body-leading);
    text-decoration: none;
  }
  .btn:hover {
    opacity: 0.85;
    text-decoration: none;
  }
</style>
