---
// A plain text back link: the Plex arrow glyph, then the label, in overline
// style.
interface Props {
  href: string;
  /** The words after the arrow. */
  label: string;
  class?: string;
}
const { href, label, class: className } = Astro.props;
---
<a class:list={['back', 'fk-overline', className]} {href}>
  <span class="glyph" aria-hidden="true">←</span>
  <span>{label}</span>
</a>

<style>
  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--fk-space-2);
    min-height: var(--fk-touch-target);
    color: var(--fk-muted);
    text-decoration: none;
  }
  .back:hover {
    color: var(--fk-text);
    text-decoration: none;
  }
  /* The arrow is set larger than the overline, but on the overline's line
     height, so a header row with a back link is as tall as one without. */
  .glyph {
    font-family: var(--fk-font-sans);
    font-size: var(--fk-body-size);
    line-height: calc(var(--fk-overline-size) * var(--fk-overline-leading));
    letter-spacing: 0;
  }
</style>
