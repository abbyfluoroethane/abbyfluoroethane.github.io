---
import { site } from '../site';
interface Props {
  id?: string;
  count?: number;
  tile?: boolean;
  historyId?: string;
}
const { id: lfmId = 'lastfm', count = 1, tile = false, historyId } = Astro.props;
---
<div id={lfmId} class:list={['lastfm-widget', { 'lastfm-widget-tile': tile }]} data-user={site.lastfm.username} data-key={site.lastfm.apiKey} data-count={count} data-tile={String(tile)} data-history-id={historyId ?? ''}>
  <p class={tile ? 'tile-live-label' : 'lastfm-status'}>Loading…</p>
</div>
<script>
  import '../scripts/lastfm';
</script>

<!--
  Shared by every Last.fm surface (music page aside and history, home tile).
  The art stack of the tile is inserted on the tile itself and the history
  rows sit outside the widget root, and all of it is built at runtime, so
  these rules have to be global rather than nested under the widget.
-->
<style is:global>
  /* ---- skeletons ----
     Every Last.fm surface waits on the same two round trips (the API call,
     then the cover image), so they all show the same flat loading cue: a
     raised block whose opacity pulses. No sweep, no gradient. */
  .skeleton {
    background-color: var(--raised);
  }
  /* The art skeleton is faded out by opacity once the cover lands, so it
     only pulses while its stack is loading and the pulse can't hold it up. */
  .skeleton:not(.art-skeleton),
  .art-stack.is-loading .art-skeleton {
    animation: skeleton-pulse 1.2s ease-in-out infinite;
  }
  @keyframes skeleton-pulse {
    50% {
      opacity: 0.5;
    }
  }
  /* One line of not-yet-arrived text. Sized in em off whatever it stands in
     for, so the same bar suits a tile caption and a page heading. */
  .skeleton-bar {
    display: inline-block;
    width: 100%;
    height: 0.8em; /* off-grid: em, follows the text line it stands in for */
    vertical-align: middle;
  }
  @media (prefers-reduced-motion: reduce) {
    /* A static block is still a clear "not here yet" cue. */
    .skeleton:not(.art-skeleton),
    .art-stack.is-loading .art-skeleton {
      animation: none;
    }
  }

  /* ---- album art ----
     Covers arrive at their own pace and change under the 30s poll, so each
     one is a stack: a loading block on top while a cover is in flight, an
     overline label underneath for tracks with no art, and one <img> layer
     per cover so a new one can crossfade over whatever is showing. Square,
     no border, no shadow. */
  .art-stack {
    position: relative;
    display: block;
    overflow: hidden;
    background-color: var(--mantle);
    --art-fallback-opacity: 1;
    --art-fallback-text: "no cover";
  }
  .art-layer {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    object-fit: cover;
    opacity: 0;
    /* ART_FADE in lastfm.ts matches this duration */
    transition: opacity 0.6s ease;
  }
  .art-layer.is-loaded {
    opacity: 1;
  }
  /* No cover: the word, in the overline style, on the mantle fill. */
  .art-fallback {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
    color: var(--muted);
  }
  .art-fallback::after {
    content: var(--art-fallback-text);
    font-family: var(--font-mono);
    font-size: var(--overline-size);
    font-weight: 500;
    line-height: var(--overline-leading);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  /* The home tile has its own fill and its own caption: no label there. */
  .tile-art .art-fallback::after {
    content: none;
  }
  .art-stack.is-artless .art-fallback {
    opacity: var(--art-fallback-opacity);
  }
  .art-skeleton {
    position: absolute;
    inset: 0;
    z-index: 2;
    opacity: 0;
    transition: opacity 0.45s ease;
    pointer-events: none;
  }
  .art-stack.is-loading .art-skeleton {
    opacity: 1;
  }

  /* ---- caption / cover handover ----
     The caption and cover belong to the same track, so they turn over as one:
     the caption dips out across the first half of the cover's crossfade and
     returns over the second, so it is never readable against another
     track's art. TEXT_SWAP in lastfm.ts sets the timing. */
  .lastfm-swap {
    transition: opacity 0.2s ease;
  }
  .lastfm-swap.is-swapping {
    opacity: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    /* No dip: the caption just changes on the beat the cover does, rather
       than blinking out and back with the transition removed. */
    .lastfm-swap.is-swapping {
      opacity: 1;
    }
  }
</style>

<style>
  /* ---- widget on the music page: state, square cover, title, artist/album ---- */
  /* The home tile positions its own widget (see .lastfm-widget-tile there). */
  .lastfm-widget:not(.lastfm-widget-tile) {
    margin: 0 0 var(--space-6);
  }
  /* A slot with nothing to show is hidden; .status would otherwise win. */
  .lastfm-widget :global([hidden]) {
    display: none !important;
  }
  .lastfm-widget :global(.lastfm-status) {
    margin: 0 0 var(--space-1);
    font-size: var(--small-size);
    line-height: var(--small-leading);
    color: var(--muted);
  }
  /* The state line: .status.ok "now playing", or an overline "last played". */
  .lastfm-widget :global(.lastfm-label) {
    margin: 0 0 var(--space-3);
  }
  .lastfm-widget :global(.lastfm-label.overline) {
    color: var(--muted);
  }
  .lastfm-widget :global(.lastfm-cover-link) {
    display: block;
    margin: 0 0 var(--space-4);
    text-decoration: none;
  }
  .lastfm-widget :global(.lastfm-cover-link:hover) {
    background-color: transparent;
  }
  .lastfm-widget :global(.lastfm-cover) {
    width: 100%;
    max-width: calc(8 * var(--space-16)); /* 512px: no taller than the page */
    aspect-ratio: 1;
  }
  .lastfm-widget :global(.lastfm-track-title) {
    margin: 0 0 var(--space-1);
    font-size: var(--subheading-size);
    font-weight: 600;
    line-height: var(--subheading-leading);
    letter-spacing: 0;
  }
  .lastfm-widget :global(.lastfm-track-artist) {
    margin: 0;
    font-size: var(--body-size);
    font-weight: 400;
    line-height: var(--body-leading);
    color: var(--muted);
  }
  .lastfm-widget :global(.lastfm-track-album) {
    margin: 0;
    font-size: var(--small-size);
    font-weight: 400;
    line-height: var(--small-leading);
    color: var(--muted);
  }
  .lastfm-widget :global(.lastfm-when) {
    margin: var(--space-2) 0 0;
    color: var(--muted);
  }
</style>
