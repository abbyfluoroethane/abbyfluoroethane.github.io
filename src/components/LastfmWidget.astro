---
import { site } from '../site';
interface Props {
  id?: string;
  count?: number;
  tile?: boolean;
  historyId?: string;
}
const { id: lfmId = 'lastfm', count = 1, tile = false, historyId } = Astro.props;
---
<div id={lfmId} class:list={['lastfm-widget', { 'lastfm-widget-tile': tile }]} data-user={site.lastfm.username} data-key={site.lastfm.apiKey} data-count={count} data-tile={String(tile)} data-history-id={historyId ?? ''}>
  <p class={tile ? 'tile-live-label' : 'lastfm-status'}>loading…</p>
</div>
<script>
  import '../scripts/lastfm';
</script>

<!--
  Shared by every Last.fm surface (music page aside and cards, home tile).
  The art stack of the tile is inserted on the tile itself and the history
  cards sit outside the widget root, and all of it is built at runtime, so
  these rules have to be global rather than nested under the widget.
-->
<style is:global>
  /* ---- skeletons ----
     Every Last.fm surface waits on the same two round trips (the API call,
     then the cover image), so they all show the same flat loading cue: a
     surface0 block whose opacity pulses. No sweep, no gradient. */
  .skeleton {
    background-color: var(--ctp-surface0);
  }
  /* The art skeleton is faded out by opacity once the cover lands, so it
     only pulses while its stack is loading and the pulse can't hold it up. */
  .skeleton:not(.art-skeleton),
  .art-stack.is-loading .art-skeleton {
    animation: skeleton-pulse 1.2s ease-in-out infinite;
  }
  @keyframes skeleton-pulse {
    50% {
      opacity: 0.5;
    }
  }
  /* One line of not-yet-arrived text. Sized in em off whatever it stands in
     for, so the same bar suits a tile caption and a page heading. A step
     darker than a plain skeleton because it sits on top of one. */
  .skeleton-bar {
    display: inline-block;
    width: 100%;
    height: 0.8em; /* off-grid: em, follows the text line it stands in for */
    vertical-align: middle;
    background-color: var(--ctp-surface1);
  }
  @media (prefers-reduced-motion: reduce) {
    /* A static block is still a clear "not here yet" cue. */
    .skeleton:not(.art-skeleton),
    .art-stack.is-loading .art-skeleton {
      animation: none;
    }
  }

  /* ---- album art ----
     Covers arrive at their own pace and change under the 30s poll, so each
     one is a stack: a loading block on top while a cover is in flight, the Last.fm
     mark underneath for tracks with no art, and one <img> layer per cover so
     a new one can crossfade over whatever is showing. */
  .art-stack {
    position: relative;
    display: block;
    overflow: hidden;
    background-color: var(--ctp-surface0);
    --art-fallback-opacity: 0.45;
  }
  .art-layer {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    object-fit: cover;
    opacity: 0;
    /* ART_FADE in lastfm.ts matches this duration */
    transition: opacity 0.6s ease;
  }
  .art-layer.is-loaded {
    opacity: 1;
  }
  .art-fallback {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }
  /* The mark is a mask, not an <img>, so one file can be tinted per surface.
     Browsers without mask support get nothing, hence the colour lives here. */
  @supports (mask-image: none) or (-webkit-mask-image: none) {
    .art-fallback {
      -webkit-mask: url("../assets/images/lastfm.svg") center / 42% no-repeat;
      mask: url("../assets/images/lastfm.svg") center / 42% no-repeat;
      background-color: currentColor;
    }
  }
  .art-stack.is-artless .art-fallback {
    opacity: var(--art-fallback-opacity);
  }
  .art-skeleton {
    position: absolute;
    inset: 0;
    z-index: 2;
    opacity: 0;
    transition: opacity 0.45s ease;
    pointer-events: none;
  }
  .art-stack.is-loading .art-skeleton {
    opacity: 1;
  }

  /* ---- caption / cover handover ----
     The caption and cover belong to the same track, so they turn over as one:
     the caption dips out across the first half of the cover's crossfade and
     returns over the second, so it is never readable against another
     track's art. TEXT_SWAP in lastfm.ts sets the timing. */
  .lastfm-swap {
    transition: opacity 0.2s ease;
  }
  .lastfm-swap.is-swapping {
    opacity: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    /* No dip: the caption just changes on the beat the cover does, rather
       than blinking out and back with the transition removed. */
    .lastfm-swap.is-swapping {
      opacity: 1;
    }
  }
</style>

<style>
  /* ---- widget on the music page: label, square cover, title, artist/album ---- */
  /* The home tile positions its own widget (see .lastfm-widget-tile there). */
  .lastfm-widget:not(.lastfm-widget-tile) {
    margin: var(--space-2) 0 var(--space-6);
  }
  .lastfm-widget :global(.lastfm-status) {
    margin: 0 0 var(--space-1);
    font-size: var(--type-caption);
    font-weight: var(--type-caption-weight);
    line-height: var(--type-caption-leading);
    text-transform: lowercase;
    color: var(--ctp-subtext0);
  }
  /* Section-heading style, lowercase because it is chrome. */
  .lastfm-widget :global(.lastfm-label) {
    margin: 0 0 var(--space-2);
    font-size: var(--type-subheader);
    font-weight: var(--type-subheader-weight);
    line-height: var(--type-subheader-leading);
    text-transform: lowercase;
  }
  .lastfm-widget :global(.lastfm-cover-link) {
    display: block;
    margin: 0 0 var(--space-4);
  }
  .lastfm-widget :global(.lastfm-cover) {
    width: 100%;
    aspect-ratio: 1;
    color: var(--ctp-overlay0);
  }
  .lastfm-widget :global(.lastfm-track-title) {
    margin: 0 0 var(--space-1);
    font-size: var(--type-item);
    font-weight: var(--type-item-weight);
    line-height: var(--type-item-leading);
  }
  .lastfm-widget :global(.lastfm-track-artist) {
    margin: 0;
    font-size: var(--type-body);
    font-weight: var(--type-body-weight);
    line-height: var(--type-body-leading);
  }
  .lastfm-widget :global(.lastfm-track-album) {
    margin: 0;
    font-size: var(--type-caption);
    font-weight: var(--type-caption-weight);
    line-height: var(--type-caption-leading);
    color: var(--ctp-subtext0);
  }
</style>
