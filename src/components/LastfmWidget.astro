---
import { site } from '../site';
interface Props {
  id?: string;
  count?: number;
  tile?: boolean;
  historyId?: string;
}
const { id: lfmId = 'lastfm', count = 1, tile = false, historyId } = Astro.props;
---
<div id={lfmId} class:list={['lastfm-widget', { 'lastfm-widget-tile': tile }]} data-user={site.lastfm.username} data-key={site.lastfm.apiKey} data-count={count} data-tile={String(tile)} data-history-id={historyId ?? ''}>
  <p class={tile ? 'tile-live-label' : 'lastfm-status'}>loading…</p>
</div>
<script>
  import '../scripts/lastfm';
</script>
