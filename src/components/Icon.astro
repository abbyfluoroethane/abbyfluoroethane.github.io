export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  /** Accessible name. Without it, the icon is decorative and hidden. */
  label?: string;
  class?: string;
}
const { name, label, class: className } = Astro.props;
const { width, d } = icons[name];
---
<svg
  class={className}
  viewBox={`0 0 ${width} 1024`}
  width="1em"
  height="1em"
  fill="currentColor"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <path transform="translate(0 960) scale(1 -1)" d={d} />
</svg>
