---
// Phosphor icons, inlined so they take the text color. Style guide order of
// choice: a word first, a Plex glyph (→ ↗ ← × ✓) second, an icon third.
// Weight follows the text: light beside the quiet voice, regular beside
// reading text, bold beside the loud voice. Size follows the line: 16px with
// 12-14px text, 20px with 16px text, 24px with 18px text and up.
import { phosphor } from './phosphor';

export type IconName = keyof typeof phosphor;

interface Props {
  name: IconName;
  weight?: 'light' | 'regular' | 'bold';
  /** Pixel size. Defaults to 1em, so the icon follows the font size. */
  size?: number;
  /** Accessible name. Without it, the icon is decorative and hidden. */
  label?: string;
  class?: string;
}
const { name, weight = 'regular', size, label, class: className } = Astro.props;
const dim = size ? `${size}px` : '1em';
---
<svg
  class:list={['icon', className]}
  viewBox="0 0 256 256"
  width={dim}
  height={dim}
  fill="currentColor"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={phosphor[name][weight]}
/>
