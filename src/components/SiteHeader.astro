---
// The Zune / Windows Phone header: a small app name over a big page title,
// then the nav. The home page shows only the big name and no nav.
import { site } from '../site';
import { getNav } from '../lib/collections';

interface Props {
  title?: string;
  /** Big label. Defaults to the title. */
  appName?: string;
}
const { title, appName } = Astro.props;
const path = Astro.url.pathname;
const isHome = path === '/';
// The blog and projects links stay current on their child pages.
const isCurrent = (url: string) =>
  path === url || (['/blog/', '/projects/'].includes(url) && path.startsWith(url));
const nav = (await getNav()).filter((s) => s.navbar);
---
<header>
  {title ? (
    <>
      <p class="app-name"><a href="/">{site.title}</a></p>
      <p class="title">{appName ?? title}</p>
    </>
  ) : (
    <p class="title">{site.title}</p>
  )}
  {!isHome && (
    <nav>
      <a href="/">home</a>
      {nav.map((s) => (
        <a href={s.url} aria-current={isCurrent(s.url) ? 'page' : undefined}>{s.name}</a>
      ))}
    </nav>
  )}
</header>

<style>
  .app-name,
  .title,
  nav {
    animation: metro-enter 0.7s var(--ease-metro) backwards;
  }
  nav {
    animation-delay: 60ms;
  }

  .app-name {
    margin: 0 0 0.25rem;
    font-size: 1rem;
    letter-spacing: 0.06em;
    text-transform: lowercase;
    color: var(--ctp-subtext0);
  }
  .app-name a {
    color: inherit;
  }
  .app-name a:hover {
    color: var(--ctp-pink);
    text-decoration: none;
  }

  .title {
    margin: 0 0 1.25rem;
    font-size: clamp(3rem, 9vw, 5.5rem);
    font-weight: 300;
    letter-spacing: -0.03em;
    line-height: 1.05;
    text-transform: lowercase;
  }

  /* Phone: a Windows Phone pivot, one line that scrolls instead of wrapping. */
  nav {
    display: flex;
    flex-wrap: nowrap;
    gap: 1.25rem;
    margin: 0.5rem 0 1rem;
    padding-bottom: 0.375rem;
    overflow-x: auto;
    scrollbar-width: none;
    mask-image: linear-gradient(to right, black calc(100% - 2rem), transparent 100%);
  }
  nav::-webkit-scrollbar {
    display: none;
  }
  nav a {
    flex: 0 0 auto;
    font-size: 1.1875rem;
    font-weight: 300;
    text-transform: lowercase;
    color: var(--ctp-overlay0);
  }
  nav a:hover {
    color: var(--ctp-pink);
    text-decoration: none;
  }
  nav a[aria-current='page'] {
    color: var(--ctp-text);
  }

  /* Desktop: the full nav wraps instead of scrolling. */
  @media (min-width: 768px) {
    nav {
      flex-wrap: wrap;
      column-gap: 1.5rem;
      margin-bottom: 1.5rem;
      padding-bottom: 0;
      overflow: visible;
      mask-image: none;
    }
    nav a {
      font-size: clamp(1.5rem, 4.2vw, 1.9375rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .app-name,
    .title,
    nav {
      animation: none;
    }
  }
</style>
