---
// The Zune / Windows Phone header: a small app name over a big page title,
// then the nav. The home page shows only the big name and no nav.
// On a detail page (a blog post) the header is the item itself: the Windows 8
// back button, then the item title in its own case.
import { site } from '../site';
import { getNav } from '../lib/collections';
import BackButton from './BackButton.astro';

export interface Props {
  title?: string;
  /** Big label. Defaults to the title. */
  appName?: string;
  /** Detail pages: the page to go back to. */
  back?: { href: string; label: string };
  /** Render the label as a paragraph when the page has its own h1. */
  plainTitle?: boolean;
}
const { title, appName, back, plainTitle = false } = Astro.props;
const path = Astro.url.pathname;
const isHome = path === '/';
// The blog and projects links stay current on their child pages.
const isCurrent = (url: string) =>
  path === url || (['/blog/', '/projects/'].includes(url) && path.startsWith(url));
const nav = (await getNav()).filter((s) => s.navbar);
---
<header class:list={{ home: !title }}>
  {title ? (
    <>
      <p class="app-name"><a href="/">{site.title}</a></p>
      <div class:list={['title-row', { detail: back }]}>
        {back && <BackButton class="title-back" href={back.href} label={back.label} iconOnly />}
        {plainTitle ? <p class="title">{appName ?? title}</p> : <h1 class="title">{appName ?? title}</h1>}
      </div>
    </>
  ) : (
    <p class="title">{site.title}</p>
  )}
  {!isHome && (
    <nav>
      <a href="/">home</a>
      {nav.map((s) => (
        <a href={s.url} aria-current={isCurrent(s.url) ? 'page' : undefined}>{s.name}</a>
      ))}
    </nav>
  )}
</header>

<style>
  .app-name,
  .title,
  nav {
    animation: metro-enter 0.7s var(--ease-metro) backwards;
  }
  nav {
    animation-delay: 60ms;
  }

  /* Phone: the app name is a link, so it gets a full touch target. */
  .app-name {
    margin: 0;
    font-size: var(--type-caption);
    font-weight: var(--type-caption-weight);
    line-height: var(--type-caption-leading);
    letter-spacing: 0.06em;
    text-transform: lowercase;
    color: var(--ctp-subtext0);
  }
  .app-name a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    color: inherit;
  }
  .app-name a:hover {
    color: var(--ctp-pink);
    text-decoration: none;
  }

  .title {
    margin: 0 0 var(--space-2);
    font-size: var(--type-header);
    font-weight: var(--type-header-weight);
    line-height: var(--type-header-leading);
    letter-spacing: -0.03em;
    text-transform: lowercase;
  }
  /* A detail page title is content: keep the author's case, and cap the
     width so a long title wraps into a block instead of a 1400px line. */
  .detail .title {
    max-width: 20em;
    text-transform: none;
  }
  /* Phone: a long post title at header size runs to six lines, so detail
     titles step down to the content-title size. */
  @media (max-width: 767px) {
    .detail .title {
      font-size: var(--type-title-lg);
      line-height: var(--type-title-lg-leading);
    }
    .title-row :global(.title-back) {
      margin-top: calc((var(--type-title-lg) * var(--type-title-lg-leading) - 41px) / 2); /* off-grid: 41px is the WinJS button */
    }
  }
  /* Phone: the back button sits on the first line, left of the title. */
  .title-row.detail {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
  }
  .title-row :global(.title-back) {
    flex: 0 0 auto;
    /* Center the 41px button on the first line of the title. */
    margin-top: calc((var(--type-header) * var(--type-header-leading) - 41px) / 2); /* off-grid: 41px is the WinJS button */
  }

  /* Phone: a Windows Phone pivot, one line that scrolls instead of wrapping.
     The scroller runs to the screen edge, so items bleed off the right: the
     Metro cue that there is more. No fade. */
  nav {
    display: flex;
    flex-wrap: nowrap;
    gap: var(--space-4);
    margin: 0 calc(-1 * var(--space-2)) var(--space-4) 0;
    padding-right: var(--space-2);
    overflow-x: auto;
    scrollbar-width: none;
  }
  nav::-webkit-scrollbar {
    display: none;
  }
  /* Home has no nav: leave a grid unit before the content. */
  header.home {
    padding-bottom: var(--space-4);
  }
  nav a {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    font-size: var(--type-subheader);
    font-weight: var(--type-subheader-weight);
    line-height: var(--type-subheader-leading);
    text-transform: lowercase;
    color: var(--ctp-overlay1); /* inactive pivot items are dimmed */
  }
  nav a:hover {
    color: var(--ctp-pink);
    text-decoration: none;
  }
  nav a[aria-current='page'] {
    color: var(--ctp-text);
  }

  /* Desktop silhouette. The title baseline sits --header-baseline from the
     top. Selawik Light's baseline is 0.893em below the top of a 1.05 line
     box (measured in the browser: 50px at 56px). So the title line starts at
     100px - 0.893 * font-size, and the app name (one caption line plus
     --space-1) sits above it. The nav starts on the next 20px line. */
  @media (min-width: 768px) {
    header {
      padding-top: calc(
        var(--header-baseline) - 0.893 * var(--type-header)
        - var(--type-caption) * var(--type-caption-leading) - var(--space-1)
      );
    }
    .app-name {
      margin-bottom: var(--space-1);
    }
    .app-name a {
      display: inline;
      min-height: 0;
    }
    /* The home page has no app name: the title takes its place. */
    header.home {
      padding-top: calc(var(--header-baseline) - 0.893 * var(--type-header));
      padding-bottom: 0;
      min-height: var(--content-top);
      box-sizing: border-box;
    }
    /* The line box ends 0.157em below the baseline; pad to the 120px line. */
    .title {
      margin-bottom: calc(var(--space-4) - 0.157 * var(--type-header));
    }
    nav {
      flex-wrap: wrap;
      margin-right: 0;
      padding-right: 0;
      overflow: visible;
    }
    /* Windows 8 silhouette: the back button sits in the left margin, its
       left edge 40px from the window edge, so the title keeps the 120px
       line. */
    .title-row.detail {
      position: relative;
      display: block;
    }
    .title-row :global(.title-back) {
      position: absolute;
      left: calc(var(--space-8) - var(--page-margin));
      top: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .app-name,
    .title,
    nav {
      animation: none;
    }
  }
</style>
