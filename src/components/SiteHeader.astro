---
// The one site header. Base.astro renders it on every page, the 404
// included. The Metro header: an overline over a big lowercase title, then
// the nav as a row of overline links. Hub pages use the hero (it may run off the right
// edge). Detail pages (`back` set) show their category ("blog",
// "projects") as the hero, and the item's own title below the nav in the
// title style. The home
// page shows the site name as the overline, its greeting as the hero, and
// no nav.
import { site } from '../site';
import { getNav } from '../lib/collections';
import BackButton from './BackButton.astro';

export interface Props {
  title?: string;
  /** Big label. Defaults to the title. */
  appName?: string;
  /** Detail pages: the page to go back to. */
  back?: { href: string; label: string };
  /** Render the label as a paragraph when the page has its own h1. */
  plainTitle?: boolean;
}
const { title, appName, back, plainTitle = false } = Astro.props;
const path = Astro.url.pathname;
const isHome = path === '/';
// The blog and projects links stay current on their child pages.
const isCurrent = (url: string) =>
  path === url || (['/blog/', '/projects/'].includes(url) && path.startsWith(url));
const nav = (await getNav()).filter((s) => s.navbar);
// A detail page's h1 is the item title below the nav, so its hero is a <p>.
const Tag = plainTitle || back ? 'p' : 'h1';
---
<header class:list={{ home: !title, detail: !!back }}>
  {title ? (
    <>
      <p class="overline-row overline">
        <a href="/">{site.title}</a>
        {back && <BackButton class="header-back" href={back.href} label={back.label} />}
      </p>
      <Tag class="page-title hero">{appName ?? title}</Tag>
    </>
  ) : (
    <>
      <p class="overline-row overline">{site.title}</p>
      <h1 class="page-title hero">{appName ?? site.title}</h1>
    </>
  )}
  {!isHome && (
    <nav aria-label="Site">
      <a href="/">home</a>
      {nav.map((s) => (
        <a href={s.url} aria-current={isCurrent(s.url) ? 'page' : undefined}>{s.name}</a>
      ))}
    </nav>
  )}
</header>
{back && title && <h1 class="detail-title title">{title}</h1>}

<style>
  .overline-row,
  .page-title,
  .detail-title,
  nav {
    animation: metro-enter 0.7s var(--ease-metro) backwards;
  }
  nav {
    animation-delay: 60ms;
  }

  /* The overline row: site name link, and on a detail page the back link. */
  .overline-row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin: 0;
  }
  .overline-row a {
    position: relative;
    display: inline-flex;
    align-items: center;
    color: var(--muted);
    text-decoration: none;
  }
  /* The row is one 16px line on every page, links or not. A pseudo-element
     gives each link a 40px touch target without making the row taller. */
  .overline-row :global(.header-back) {
    position: relative;
    min-height: 0;
  }
  .overline-row a::after,
  .overline-row :global(.header-back)::after {
    content: '';
    position: absolute;
    inset: calc((var(--overline-size) * var(--overline-leading) - var(--touch-target)) / 2) 0;
  }
  .overline-row a:hover {
    color: var(--text);
    text-decoration: none;
  }

  .page-title {
    margin: 0;
  }
  /* A hub hero runs off the right edge; the shell clips it. */
  /* Phones wrap the hero, so no words are lost. */
  @media (min-width: 768px) {
    .hero {
      white-space: nowrap;
    }
  }
  /* The detail item title: below the nav, title style, wraps. 24px above
     the page content, the same gap as between the nav and the title. */
  .detail-title {
    max-width: 20em;
    margin: 0 0 var(--space-6);
  }

  /* Nav: type as navigation. Overline links in one row. Phones: one line that
     scrolls, with items bleeding off the right edge (the Metro cue).
     24px under the title: the hero's tight leading lets its descenders hang
     about 13px below its line box, and the link hover fill starts 12px
     above the link text. 24px keeps the fill clear of the descenders. */
  nav {
    display: flex;
    flex-wrap: nowrap;
    margin: var(--space-6) calc(-1 * var(--space-8)) var(--space-6) calc(-1 * var(--space-2));
    padding-right: var(--space-8);
    overflow-x: auto;
    scrollbar-width: none;
  }
  nav::-webkit-scrollbar {
    display: none;
  }
  nav a {
    position: relative;
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    padding: 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--overline-size);
    font-weight: 500;
    line-height: var(--overline-leading);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted);
  }
  nav a:hover {
    background-color: var(--hover);
    color: var(--text);
    text-decoration: none;
  }
  nav a[aria-current='page'] {
    color: var(--text);
  }
  nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: var(--space-2);
    right: var(--space-2);
    bottom: var(--space-1);
    height: 2px;
    background: var(--accent);
  }

  header.home {
    padding-bottom: var(--space-4);
  }

  /* One spacing rule for every page and every width: 32px above the
     overline row (the phone side margin) and 8px between the overline and
     the title. Hub, detail and home headers differ only in the title style
     and the nav. */
  header {
    padding-top: var(--space-8);
  }
  .overline-row {
    margin-bottom: var(--space-2);
  }

  @media (min-width: 768px) {
    /* No nav on the home page: leave a group gap under the hero. */
    header.home {
      padding-bottom: var(--space-8);
    }
    nav {
      flex-wrap: wrap;
      margin-right: 0;
      padding-right: 0;
      overflow: visible;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .overline-row,
    .page-title,
    .detail-title,
    nav {
      animation: none;
    }
  }
</style>
