---
// The Metro header: an overline over a big lowercase title, then the nav as
// a row of overline links. Hub pages use the hero (it may run off the right
// edge); detail pages (`back` set) use the title style and wrap. The home
// page shows the site name as the hero and no nav.
import { site } from '../site';
import { getNav } from '../lib/collections';
import BackButton from './BackButton.astro';

export interface Props {
  title?: string;
  /** Big label. Defaults to the title. */
  appName?: string;
  /** Detail pages: the page to go back to. */
  back?: { href: string; label: string };
  /** Render the label as a paragraph when the page has its own h1. */
  plainTitle?: boolean;
}
const { title, appName, back, plainTitle = false } = Astro.props;
const path = Astro.url.pathname;
const isHome = path === '/';
// The blog and projects links stay current on their child pages.
const isCurrent = (url: string) =>
  path === url || (['/blog/', '/projects/'].includes(url) && path.startsWith(url));
const nav = (await getNav()).filter((s) => s.navbar);
const Tag = plainTitle ? 'p' : 'h1';
---
<header class:list={{ home: !title, detail: !!back }}>
  {title ? (
    <>
      <p class="overline-row overline">
        <a href="/">{site.title}</a>
        {back && <BackButton class="header-back" href={back.href} label={back.label} />}
      </p>
      <Tag class:list={['page-title', back ? 'title' : 'hero']}>{appName ?? title}</Tag>
    </>
  ) : (
    <p class="page-title hero">{site.title}</p>
  )}
  {!isHome && (
    <nav aria-label="Site">
      <a href="/">home</a>
      {nav.map((s) => (
        <a href={s.url} aria-current={isCurrent(s.url) ? 'page' : undefined}>{s.name}</a>
      ))}
    </nav>
  )}
</header>

<style>
  .overline-row,
  .page-title,
  nav {
    animation: metro-enter 0.7s var(--ease-metro) backwards;
  }
  nav {
    animation-delay: 60ms;
  }

  /* The overline row: site name link, and on a detail page the back link. */
  .overline-row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin: 0;
  }
  .overline-row a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    color: var(--muted);
    text-decoration: none;
  }
  .overline-row a:hover {
    color: var(--text);
    text-decoration: none;
  }

  .page-title {
    margin: 0;
  }
  /* A hub hero runs off the right edge; the shell clips it. */
  .hero {
    white-space: nowrap;
  }
  /* A detail title wraps. */
  .title {
    max-width: 20em;
  }

  /* Nav: type as navigation. Overline links in one row. Phones: one line that
     scrolls, with items bleeding off the right edge (the Metro cue). */
  nav {
    display: flex;
    flex-wrap: nowrap;
    margin: var(--space-2) calc(-1 * var(--space-8)) var(--space-6) calc(-1 * var(--space-2));
    padding-right: var(--space-8);
    overflow-x: auto;
    scrollbar-width: none;
  }
  nav::-webkit-scrollbar {
    display: none;
  }
  nav a {
    position: relative;
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    padding: 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--overline-size);
    font-weight: 500;
    line-height: var(--overline-leading);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted);
  }
  nav a:hover {
    background-color: var(--hover);
    color: var(--text);
    text-decoration: none;
  }
  nav a[aria-current='page'] {
    color: var(--text);
  }
  nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: var(--space-2);
    right: var(--space-2);
    bottom: var(--space-1);
    height: 2px;
    background: var(--accent);
  }

  header.home {
    padding-bottom: var(--space-4);
  }

  /* Phones: no pinned baseline; the overline row, then the title. */
  header {
    padding-top: var(--space-2);
  }

  /* Desktop: the title baseline sits --header-baseline (100px) from the top.
     Plex Sans: unitsPerEm 1000, ascender 1025, descender 275, so the content
     area is 1.3em. With line-height L the baseline is at
     (L - 1.3) / 2 * fs + 1.025 * fs from the top of the line box:
       hero  96px, L 0.917 -> 80.0px
       title 56px, L 1.071 -> 51.0px
     The overline line is 16px and the gap below it is --space-1 (4px), so the
     top padding is 100 - 16 - 4 - baseline offset. A hub hero needs 0; if the
     hero is below 96px (narrow desktop), max() keeps the padding at 0. */
  @media (min-width: 768px) {
    header {
      --overline-line: calc(var(--overline-size) * var(--overline-leading));
      min-height: var(--content-top);
      box-sizing: border-box;
      padding-top: max(
        0px,
        calc(
          var(--header-baseline) - var(--overline-line) - var(--space-1)
          - (var(--hero-size) * ((var(--hero-leading) - 1.3) / 2 + 1.025))
        )
      );
    }
    header.detail {
      padding-top: calc(
        var(--header-baseline) - var(--overline-line) - var(--space-1)
        - (var(--title-size) * ((var(--title-leading) - 1.3) / 2 + 1.025))
      );
    }
    .overline-row {
      margin-bottom: var(--space-1);
    }
    /* The overline row is 16px tall on desktop: the touch target is for phones. */
    .overline-row a {
      min-height: 0;
    }
    .overline-row :global(.header-back) {
      min-height: 0;
    }
    /* The home page has no overline: the hero baseline alone sets the top. */
    header.home {
      padding-top: calc(
        var(--header-baseline)
        - (var(--hero-size) * ((var(--hero-leading) - 1.3) / 2 + 1.025))
      );
      padding-bottom: 0;
    }
    nav {
      flex-wrap: wrap;
      margin-right: 0;
      padding-right: 0;
      overflow: visible;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .overline-row,
    .page-title,
    nav {
      animation: none;
    }
  }
</style>
