---
// A project: the detail layout with the start year, status and link in the
// rail, and the project description as the standfirst.
import type { CollectionEntry } from 'astro:content';
import DetailLayout from './DetailLayout.astro';
import Button from '../components/Button.astro';

export interface Props {
  project: CollectionEntry<'projects'>['data'];
  /** Headings from render(project). Depth 2 and 3 make the contents. */
  headings?: { depth: number; slug: string; text: string }[];
}
const { project, headings } = Astro.props;
const { title, status, date, description, external_url, url_text } = project;
const year = date.getUTCFullYear();
---
<DetailLayout
  {title}
  {description}
  subtitle={description}
  {headings}
  appName="projects"
  back={{ href: '/projects/', label: 'back to projects' }}
>
  <Fragment slot="meta">
    <p class="overline muted">{status === 'active' ? `${year} – present` : year}</p>
    <p class="rail-caption">
      {status === 'active'
        ? <span class="status ok">Active</span>
        : <span class="status">Archived</span>}
    </p>
    {external_url && (
      <p class="link"><Button href={external_url}>{url_text || 'External link'} ↗</Button></p>
    )}
  </Fragment>
  <slot />
</DetailLayout>

<style>
  .overline {
    margin: 0;
  }
  .link {
    margin: var(--space-3) 0 0;
  }
</style>
