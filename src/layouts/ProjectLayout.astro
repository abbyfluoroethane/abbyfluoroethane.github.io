---
import Base from './Base.astro';

export interface Props {
  title: string;
  status: string;
  date?: Date;
  external_url?: string;
  url_text?: string;
  description?: string;
  currentPath: string;
}
const { title, status, date, external_url, url_text, description, currentPath } = Astro.props;
---
<Base {title} {description} {currentPath} appName="projects" ogType="article" currentSection="projects">
  <div class="post-layout">
    <aside class="post-meta">
      <p class="post-date">
        <span class={`status-pill status-${status}`}>{status}</span>
        {date && `· ${date.getUTCFullYear()}`}
      </p>
      <h1 class="post-title">{title}</h1>
      {external_url && <p><a class="btn" href={external_url}>{url_text || 'external link'}</a></p>}
      <p class="back-link"><a href="/projects/">← back to projects</a></p>
    </aside>
    <article class="post-content">
      <slot />
    </article>
  </div>
</Base>
