---
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';

export interface Props {
  project: CollectionEntry<'projects'>['data'];
}
const { title, status, date, description, external_url, url_text } = Astro.props.project;
---
<Base {title} {description} appName="projects" ogType="article">
  <div class="post-layout">
    <aside class="post-meta">
      <p class="post-date">
        <span class={`status-pill status-${status}`}>{status}</span>
        · {date.getUTCFullYear()}
      </p>
      <h1 class="post-title">{title}</h1>
      {external_url && <p><a class="btn" href={external_url}>{url_text ?? 'external link'}</a></p>}
      <p class="back-link"><a href="/projects/">← back to projects</a></p>
    </aside>
    <article class="post-content">
      <slot />
    </article>
  </div>
</Base>
