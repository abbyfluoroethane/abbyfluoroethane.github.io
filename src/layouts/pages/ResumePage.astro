---
// Wrapper for resume.md: frontmatter -> ResumeLayout.
import ResumeLayout from '../ResumeLayout.astro';
const { frontmatter } = Astro.props;
---
<ResumeLayout
  title={frontmatter.title}
  full_name={frontmatter.full_name}
  tagline={frontmatter.tagline}
  currentPath={Astro.url.pathname}
>
  <slot />
</ResumeLayout>
