---
import '../styles/global.css';
import '../styles/prose.css';
import '../styles/cards.css';
import SiteHeader from '../components/SiteHeader.astro';
import selawkLight from '../assets/fonts/selawkl.woff2?url';
import selawkRegular from '../assets/fonts/selawk.woff2?url';
import { site } from '../site';
import { formatXmlDate } from '../lib/format';

export interface Props {
  title?: string;
  description?: string;
  /** Share image, as a root-relative or absolute URL. */
  image?: string;
  /** Header label. Defaults to the title. */
  appName?: string;
  /** Detail pages: the back button target shown before the header title. */
  back?: { href: string; label: string };
  /** Skip the header and nav, for a page that owns the whole viewport (404). */
  bare?: boolean;
  /** Load MathJax for \( \) and \[ \] delimiters. */
  mathjax?: boolean;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
}

const {
  title,
  description = site.description,
  image,
  appName,
  back,
  bare = false,
  mathjax = false,
  ogType = 'website',
  publishedTime,
} = Astro.props;

const path = Astro.url.pathname;
const abs = (p: string) => new URL(p, Astro.site).href;
const fullTitle = title ? `${title} · ${site.title}` : site.title;
const ogTitle = title ?? site.title;
const ogImage = abs(image ?? '/assets/favicon/konata-512.png');
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={abs(path)}>
  <meta property="og:type" content={ogType}>
  {publishedTime && <meta property="article:published_time" content={formatXmlDate(publishedTime)}>}
  <meta property="og:site_name" content={site.title}>
  <meta property="og:title" content={ogTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={abs(path)}>
  <meta property="og:image" content={ogImage}>
  {/* "summary", not "summary_large_image", for the fallback: the fallback is
      the square favicon, and a large card crops a square badly. */}
  <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'}>
  <meta name="twitter:title" content={ogTitle}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>
  <link rel="alternate" type="application/rss+xml" href={abs('/feed.xml')} title={site.title}>
  <link rel="sitemap" href="/sitemap-index.xml">
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#eff1f5">
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1e1e2e">
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon/konata-16.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon/konata-32.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/assets/favicon/konata-192.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicon/apple-touch-icon.png">
  <link rel="preload" href={selawkLight} as="font" type="font/woff2" crossorigin>
  <link rel="preload" href={selawkRegular} as="font" type="font/woff2" crossorigin>
  {mathjax && <script is:inline defer src="https://cdnjs.cloudflare.com/ajax/libs/mathjax/3.2.2/es5/tex-mml-chtml.min.js" integrity="sha384-M5jmNxKC9EVnuqeMwRHvFuYUE8Hhp0TgBruj/GZRkYtiMrCRgH7yvv5KY+Owi7TW" crossorigin="anonymous"></script>}
</head>
<body>
  {bare ? <slot /> : (
    <div class="page-shell">
      <SiteHeader {title} {appName} {back} />
      <main>
        <slot />
      </main>
    </div>
  )}
</body>
</html>

<style>
  /* Phone: Windows Phone tight edges, 10px each side. Desktop: the Windows 8
     silhouette, left margin 120px; the header sets its own top offset. */
  .page-shell {
    padding: var(--space-2) var(--space-2) var(--space-12);
  }
  @media (min-width: 768px) {
    .page-shell {
      padding: 0 var(--space-16) var(--space-16) var(--page-margin);
    }
  }

  /* Page content slides in after the header. The home tile grid runs its
     own per-row stagger, so it opts out. */
  main > :global(*:not(.tile-grid)) {
    animation: metro-enter 0.7s var(--ease-metro) 120ms backwards;
  }
  @media (prefers-reduced-motion: reduce) {
    main > :global(*) {
      animation: none;
    }
  }
</style>
