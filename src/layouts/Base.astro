---
// Fonts first, then fluorokit (design system 1.1): structure, the ink
// theme and the shared classes.
import '../styles/fonts.css';
import 'fluorokit/structure.css';
import 'fluorokit/themes/ink.css';
import 'fluorokit/base.css';
import '../styles/global.css';
import '../styles/prose.css';
import '../styles/cards.css';
import SiteHeader from '../components/SiteHeader.astro';
import { site } from '../site';
import { getNav } from '../lib/collections';
import { enterDirectionScript } from 'fluorokit/enter';
import { formatXmlDate } from '../lib/format';

export interface Props {
  title?: string;
  description?: string;
  /** Header label. Defaults to the title. */
  appName?: string;
  /** Render the header label as a paragraph, for a page whose own h1 is the content title. */
  plainTitle?: boolean;
  /** Detail pages: the back button target shown before the header title. */
  back?: { href: string; label: string };
  /** Load MathJax for \( \) and \[ \] delimiters. */
  mathjax?: boolean;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  /** Skip the shell and header, for a page that owns the whole viewport (the 404 bluescreen). */
  bare?: boolean;
  /** Keep the page out of search results, with no canonical URL (the 404). */
  noindex?: boolean;
  /** One browser-chrome color for both schemes, in place of the Catppuccin pair. */
  themeColor?: string;
}

const {
  title,
  description = site.description,
  appName,
  plainTitle = false,
  back,
  mathjax = false,
  ogType = 'website',
  publishedTime,
  bare = false,
  noindex = false,
  themeColor,
} = Astro.props;

const path = Astro.url.pathname;
const abs = (p: string) => new URL(p, Astro.site).href;
// Titles are lowercase by hand, so the tab and og:title read
// "projects · abby bigaouette".
const fullTitle = title ? `${title} · ${site.title}` : site.title;
const ogImage = abs('/og-image.png');
// The pages in nav order: home, then each nav bar entry on this site. A page
// slides in from the side it lies on, seen from the page before it.
const navPaths = ['/', ...(await getNav()).filter((s) => s.navbar && s.url.startsWith('/')).map((s) => s.url)];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  {/* Before the first paint, so the page-enter starts on the right side. */}
  <script is:inline set:html={enterDirectionScript(navPaths)} />
  <meta name="description" content={description}>
  {noindex ? <meta name="robots" content="noindex"> : <link rel="canonical" href={abs(path)}>}
  <meta property="og:type" content={ogType}>
  {publishedTime && <meta property="article:published_time" content={formatXmlDate(publishedTime)}>}
  <meta property="og:site_name" content={site.title}>
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  {!noindex && <meta property="og:url" content={abs(path)}>}
  <meta property="og:image" content={ogImage}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={fullTitle}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>
  <link rel="alternate" type="application/rss+xml" href={abs('/feed.xml')} title={site.title}>
  <link rel="sitemap" href="/sitemap-index.xml">
  {themeColor ? (
    <meta name="theme-color" content={themeColor}>
  ) : (
    <>
      <meta name="theme-color" content="#10131d">
      <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f5f6f8">
    </>
  )}
  {/* The ab monogram from the brand package (logos/). The SVG switches
      between Latte and Mocha with the color scheme. The ICO (16, 32, 48)
      is Mocha, for browsers without SVG favicons. iOS reads only the PNG. */}
  <link rel="icon" href="/favicon.ico" sizes="48x48">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="preload" href="/fonts/IBMPlexSans-Light.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/IBMPlexSans-Regular.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/IBMPlexMono-Medium.woff2" as="font" type="font/woff2" crossorigin>
  {mathjax && <script is:inline defer src="https://cdnjs.cloudflare.com/ajax/libs/mathjax/3.2.2/es5/tex-mml-chtml.min.js" integrity="sha384-M5jmNxKC9EVnuqeMwRHvFuYUE8Hhp0TgBruj/GZRkYtiMrCRgH7yvv5KY+Owi7TW" crossorigin="anonymous"></script>}
</head>
<body>
  {bare ? (
    <slot />
  ) : (
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page-shell">
      <SiteHeader {title} {appName} {back} {plainTitle} />
      <main id="main" tabindex="-1">
        <slot />
      </main>
    </div>
  )}
</body>
</html>

<style>
  /* The first stop for a keyboard: jumps over the header and nav. Off
     screen until it takes focus. */
  .skip-link {
    position: absolute;
    top: var(--fk-space-2);
    left: var(--fk-space-2);
    z-index: 10;
    padding: var(--fk-space-2) var(--fk-space-4);
    background: var(--fk-raised);
    color: var(--fk-text);
    font-weight: 600;
    text-decoration: none;
    transform: translateY(-200%);
  }
  .skip-link:focus {
    transform: none;
  }
  main:focus {
    outline: none;
  }

  /* One left edge: --space-8 on phones, --page-margin on desktop. The shell
     clips sideways so a hub hero can run off the right edge without a
     horizontal scrollbar. */
  .page-shell {
    padding: 0 var(--fk-space-8) var(--fk-space-16);
    overflow-x: clip;
  }
  @media (min-width: 768px) {
    .page-shell {
      padding: 0 var(--fk-space-16) var(--fk-space-16) var(--fk-page-margin);
    }
  }
  /* Wide windows: scale the whole page, the way browser zoom does, so
     type, tiles, icons and spacing grow together and the layout keeps its
     proportions. The steps are small and stop at 1.3×, so the page fills
     more of a wide window without the type getting huge: 1500px shows it
     at 1.1×, 1800px at 1.2×, 2200px and wider at 1.3×. zoom changes layout
     size, so text stays sharp. */
  @media (min-width: 1500px) {
    .page-shell {
      zoom: 1.1;
    }
  }
  @media (min-width: 1800px) {
    .page-shell {
      zoom: 1.2;
    }
  }
  @media (min-width: 2200px) {
    .page-shell {
      zoom: 1.3;
    }
  }

  /* Page content slides in after the header. The home tile grid runs its
     own per-row stagger, so it opts out. */
  main > :global(*:not(.tile-grid)) {
    animation: fk-enter var(--fk-enter-duration) var(--fk-ease-metro) 120ms backwards;
  }
  @media (prefers-reduced-motion: reduce) {
    main > :global(*) {
      animation: none;
    }
  }
</style>
