---
// Layout for src/pages/resume.md. Markdown pages pass their front matter
// as `frontmatter`.
import Base from './Base.astro';
import PageColumns from '../components/PageColumns.astro';
import { site } from '../site';

export interface Props {
  frontmatter: {
    title: string;
    full_name: string;
    tagline: string;
    description?: string;
  };
}
const { title, full_name, tagline, description } = Astro.props.frontmatter;
---
<Base {title} {description}>
  <PageColumns>
    <Fragment slot="aside">
      <p class="fk-overline fk-muted name-overline">{site.title}</p>
      <h2 class="post-title">{full_name}</h2>
      <p class="post-tagline">{tagline}</p>
    </Fragment>
    <slot />
  </PageColumns>
</Base>


<style>
  /* The overline above the title-style name. */
  .name-overline {
    margin: 0 0 var(--fk-space-1);
  }
</style>

<style is:global>
  /* The résumé prints on the paper theme (print.md): no background,
     0.75in margins, Plex Sans only. The fluorokit theme sets the paper colors in
     @media print. */
  @page {
    size: letter;
    margin: 0.75in;
  }
  @media print {
    html,
    body {
      height: auto;
      background: none;
      color: var(--fk-text);
    }
    body {
      font-family: var(--fk-font-sans);
      font-size: 10pt;
      line-height: 1.4;
    }
    .page-shell {
      padding: 0;
    }
    /* Site header, nav and skip link stay on screen. */
    .page-shell > header,
    .skip-link {
      display: none;
    }
    main > * {
      animation: none;
    }
    .post-layout {
      display: block;
    }
    .post-meta {
      position: static;
      margin-bottom: 16pt;
    }
    .post-title {
      font-size: 36pt;
      line-height: 1.05;
    }
    .post-tagline {
      font-size: 10pt;
    }
    /* Sections open with an overline. */
    .post-content h2 {
      margin: 18pt 0 6pt;
      font-family: var(--fk-font-mono);
      font-size: 8pt;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--fk-muted);
    }
    .post-content h3 {
      margin: 10pt 0 0;
      font-size: 12pt;
      break-after: avoid;
    }
    .post-content h4 {
      margin: 0 0 4pt;
      font-size: 8pt;
      color: var(--fk-muted);
    }
    .post-content li,
    .post-content p {
      max-width: none;
    }
    a {
      color: var(--fk-text);
      text-decoration: none;
    }
    h2, h3, h4 {
      break-after: avoid;
    }
    li {
      break-inside: avoid;
    }
  }
</style>
