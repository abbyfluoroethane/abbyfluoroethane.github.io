---
// Layout for src/pages/resume.md. Markdown pages pass their front matter
// as `frontmatter`.
import Base from './Base.astro';

export interface Props {
  frontmatter: {
    title: string;
    full_name: string;
    tagline: string;
    description?: string;
  };
}
const { title, full_name, tagline, description } = Astro.props.frontmatter;
---
<Base {title} {description}>
  <div class="post-layout">
    <aside class="post-meta">
      <h2 class="post-title">{full_name}</h2>
      <h2 class="resume-tagline">{tagline}</h2>
    </aside>
    <article class="post-content">
      <slot />
    </article>
  </div>
</Base>
