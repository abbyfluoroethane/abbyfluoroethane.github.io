---
import Base from './Base.astro';
import PageColumns from '../components/PageColumns.astro';
import { formatLongDate } from '../lib/format';
import { inlineMarkdown } from '../lib/inlineMarkdown';

export interface Props {
  title: string;
  date: Date;
  /** Standfirst under the title. Inline markdown. */
  subtitle?: string;
  /** Credit line: a byline, a photo credit, where a piece first ran. Inline markdown. */
  attribution?: string;
  description?: string;
  mathjax?: boolean;
  /** Header label. Defaults to "blog". */
  appName?: string;
}
const { title, date, subtitle, attribution, description, mathjax, appName = 'blog' } = Astro.props;
---
<Base {title} {description} {mathjax} {appName} ogType="article" publishedTime={date}>
  <PageColumns>
    <Fragment slot="aside">
      <p class="post-date">{formatLongDate(date)}</p>
      <h1 class="post-title">{title}</h1>
      {subtitle && <h2 class="post-subtitle" set:html={inlineMarkdown(subtitle)} />}
      {attribution && <h4 class="post-attribution" set:html={inlineMarkdown(attribution)} />}
      <p class="back-link"><a href="/blog/">← back to blog</a></p>
    </Fragment>
    <slot />
  </PageColumns>
</Base>
