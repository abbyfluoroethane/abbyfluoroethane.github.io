---
// A blog post: the detail layout with the agenda date in the rail.
import DetailLayout from './DetailLayout.astro';
import DateBlock from '../components/DateBlock.astro';

export interface Props {
  title: string;
  date: Date;
  /** Standfirst under the title. Inline markdown. */
  subtitle?: string;
  /** Credit line: a byline, a photo credit, where a piece first ran. Inline markdown. */
  attribution?: string;
  description?: string;
  mathjax?: boolean;
  /** Reading time in minutes, shown in the rail. */
  minutes?: number;
  /** Headings from render(post). Depth 2 and 3 make the contents. */
  headings?: { depth: number; slug: string; text: string }[];
  /** Where the back button goes. Defaults to the blog. */
  back?: { href: string; label: string };
}
const {
  date,
  minutes,
  back = { href: '/blog/', label: 'back to blog' },
  ...rest
} = Astro.props;
---
<DetailLayout {...rest} appName="blog" {back} publishedTime={date}>
  <Fragment slot="meta">
    <DateBlock {date} />
    <p class="rail-caption">
      {date.getUTCFullYear()}
      {minutes && <span> · {minutes} min read</span>}
    </p>
  </Fragment>
  <slot />
</DetailLayout>
