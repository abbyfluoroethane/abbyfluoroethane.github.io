---
// A detail page as an agenda entry (blog posts, projects): a rail with the
// back button, a meta block and the contents, beside one reading column. On a
// phone the rail becomes a row above the title and the contents a disclosure.
// The page fills the meta block through the "meta" slot; .rail-caption styles
// a caption line inside it.
import Base from './Base.astro';
import { inlineMarkdown } from '../lib/inlineMarkdown';

export interface Props {
  title: string;
  /** The category ("blog", "projects"): the hero above the nav. The item
      title goes below the nav. */
  appName?: string;
  back: { href: string; label: string };
  /** Posts: the publish date, for the article meta tag. */
  publishedTime?: Date;
  /** Standfirst under the title. Inline markdown. */
  subtitle?: string;
  /** Credit line: a byline, a photo credit, where a piece first ran. Inline markdown. */
  attribution?: string;
  description?: string;
  mathjax?: boolean;
  /** Headings from render(post). Depth 2 and 3 make the contents. */
  headings?: { depth: number; slug: string; text: string }[];
  /** Blog long-form only: set the body in Plex Serif. Projects stay in Plex Sans. */
  serif?: boolean;
}
const {
  title,
  appName,
  back,
  publishedTime,
  subtitle,
  attribution,
  description,
  mathjax,
  headings = [],
  serif = false,
} = Astro.props;

let contents = headings.filter(
  (h) => h.depth >= 2 && h.depth <= 3 && h.slug !== 'footnotes' && h.slug !== 'footnote-label',
);
// Margin numbers go on the depth with the most headings, so a post with one
// h2 and six h3 sections numbers the sections.
const count = (d: number) => contents.filter((h) => h.depth === d).length;
const numbered = count(3) > count(2) ? 3 : 2;
// A lone h2 over numbered h3 sections is the post's tagline, not a section.
if (numbered === 3 && count(2) === 1) contents = contents.filter((h) => h.depth === 3);
let n = 0;
const items = contents.map((h) => ({
  ...h,
  num: h.depth === numbered ? ++n : undefined,
}));
---
<Base {title} {appName} {description} {mathjax} {back} ogType="article" {publishedTime}>
  <div class="post-page">
    <aside class="rail">
      <div class="rail-top">
        <div class="rail-date">
          <slot name="meta" />
        </div>
      </div>
      {items.length > 0 && (
        <details class="contents" open>
          <summary class="fk-overline">contents</summary>
          <ol>
            {items.map((h) => (
              <li class:list={{ sub: h.depth !== numbered && numbered === 2 }}>
                <a href={`#${h.slug}`}>
                  {h.num && <span class="num">{h.num}</span>}
                  <span set:html={inlineMarkdown(h.text)} />
                </a>
              </li>
            ))}
          </ol>
        </details>
      )}
    </aside>

    <article class="post">
      {subtitle && <p class="standfirst" set:html={inlineMarkdown(subtitle)} />}
      {attribution && <p class="attribution" set:html={inlineMarkdown(attribution)} />}
      <div class:list={['prose', { serif }]} data-numbered={items.some((h) => h.num) ? numbered : undefined}><slot /></div>
    </article>
  </div>
</Base>

<script>
  // Contents: open on a desktop (the rail shows it), closed on a phone. Mark
  // the section being read. Color changes only, so no motion to reduce.
  const details = document.querySelector<HTMLDetailsElement>('.contents');
  const summary = details?.querySelector('summary');
  if (details && summary) {
    const wide = matchMedia('(min-width: 1000px)');
    // Desktop: the list is always open and its summary is a label, so it
    // leaves the tab order. Phone: a closed disclosure the summary opens.
    const sync = () => {
      details.open = wide.matches;
      summary.tabIndex = wide.matches ? -1 : 0;
    };
    sync();
    wide.addEventListener('change', sync);
    // A click is also what Enter and Space send: the label does not toggle.
    summary.addEventListener('click', (e) => {
      if (wide.matches) e.preventDefault();
    });
    // Phone: close the disclosure after a jump, so the text is in view.
    details.addEventListener('click', (e) => {
      if (!wide.matches && (e.target as HTMLElement).closest('li a')) details.open = false;
    });

    // Each contents link with the heading it points to. A link whose heading
    // is not on the page is left out, so the two stay in step.
    const sections = [...details.querySelectorAll<HTMLAnchorElement>('li a')].flatMap((link) => {
      const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)));
      return heading ? [{ link, heading }] : [];
    });
    const mark = () => {
      const line = innerHeight * 0.3;
      let current = -1;
      sections.forEach(({ heading }, i) => {
        if (heading.getBoundingClientRect().top < line) current = i;
      });
      sections.forEach(({ link }, i) => {
        if (i === current) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };
    if (sections.length) {
      addEventListener('scroll', mark, { passive: true });
      mark();
    }
  }
</script>

<style>
  /* Phone: one column. The rail is a row above the title. */
  .post-page {
    display: block;
  }
  .rail-top {
    display: flex;
    align-items: center;
    gap: var(--fk-space-3);
  }
  .rail-date {
    display: flex;
    align-items: center;
    gap: var(--fk-space-3);
  }
  /* The meta line: small and muted. A post adds .fk-data (mono, ISO date). */
  .rail-date :global(.rail-caption) {
    margin: 0;
    font-size: var(--fk-small-size);
    line-height: var(--fk-small-leading);
    color: var(--fk-muted);
  }
  .rail-date :global(.rail-caption time) {
    color: var(--fk-text);
  }
  .rail-date :global(.rail-caption span) {
    display: block;
  }

  .contents {
    margin: var(--fk-space-4) 0 0;
  }
  /* "contents" is an overline (the class): the label of the list. */
  summary {
    display: flex;
    align-items: center;
    min-height: var(--fk-touch-target);
    color: var(--fk-muted);
    cursor: pointer;
  }
  .contents ol {
    margin: 0 0 var(--fk-space-2);
    padding: 0;
    list-style: none;
  }
  .contents li {
    max-width: none;
  }
  .contents a {
    position: relative;
    display: flex;
    gap: var(--fk-space-2);
    padding: var(--fk-space-1) var(--fk-space-2);
    min-height: var(--fk-touch-target);
    align-items: center;
    font-size: var(--fk-small-size);
    line-height: var(--fk-small-leading);
    text-decoration: none;
    color: var(--fk-muted);
  }
  /* Muted text is for base only: on the hover fill it is the text color. */
  .contents a:hover {
    color: var(--fk-text);
    background-color: var(--fk-hover);
  }
  .contents a:hover .num {
    color: var(--fk-text);
  }
  /* The section being read: text color, 600, accent marker. */
  .contents a[aria-current] {
    color: var(--fk-text);
    font-weight: 600;
  }
  .contents a[aria-current]::before {
    content: "";
    position: absolute;
    top: var(--fk-space-1);
    bottom: var(--fk-space-1);
    left: 0;
    width: 2px;
    background: var(--fk-accent);
  }
  .contents li.sub a {
    padding-left: var(--fk-space-4);
  }
  .num {
    flex: 0 0 auto;
    min-width: var(--fk-space-4);
    font-family: var(--fk-font-mono);
    font-size: var(--fk-label-size);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--fk-muted);
  }

  .post {
    display: flow-root; /* contain floated images */
    min-width: 0;
    margin-top: var(--fk-space-4);
  }
  .standfirst {
    margin: 0 0 var(--fk-space-4);
    font-size: var(--fk-body-size);
    line-height: var(--fk-body-leading);
    color: var(--fk-muted);
  }
  .attribution {
    margin: 0 0 var(--fk-space-6);
    font-size: var(--fk-small-size);
    line-height: var(--fk-small-leading);
    color: var(--fk-muted);
  }

  /* Desktop: the rail is 240px on the grid and sticks while the text scrolls. */
  @media (min-width: 1000px) {
    .post-page {
      display: grid;
      grid-template-columns: calc(12 * var(--fk-space-4)) minmax(0, 42rem);
      column-gap: var(--fk-space-12);
      align-items: start;
    }
    .rail {
      position: sticky;
      top: var(--fk-space-4);
      max-height: calc(100vh - var(--fk-space-8));
      overflow-y: auto;
      scrollbar-width: none;
    }
    .rail-top {
      display: block;
    }
    .rail-date {
      display: block;
      margin-top: var(--fk-space-6);
    }
    .rail-date :global(.rail-caption) {
      margin-top: var(--fk-space-1);
    }
    .rail-date :global(.rail-caption span) {
      display: inline;
    }
    .post {
      margin-top: 0;
    }
    .contents {
      margin-top: var(--fk-space-6);
    }
    summary {
      pointer-events: none; /* open on a desktop: a label, not a control */
      min-height: var(--fk-space-6);
    }
    /* Section numbers hang in the gap between the rail and the text. */
    .post :global(.prose) {
      counter-reset: section;
    }
    .post :global(.prose[data-numbered='2'] h2),
    .post :global(.prose[data-numbered='3'] h3:not(#footnotes)) {
      counter-increment: section;
      position: relative;
    }
    .post :global(.prose[data-numbered='2'] h2)::before,
    .post :global(.prose[data-numbered='3'] h3:not(#footnotes))::before {
      content: counter(section);
      position: absolute;
      right: 100%;
      margin-right: var(--fk-space-4);
      font-family: var(--fk-font-mono);
      font-size: var(--fk-label-size);
      font-weight: 500;
      font-variant-numeric: tabular-nums;
      line-height: calc(var(--fk-heading-size) * var(--fk-heading-leading));
      color: var(--fk-muted);
    }
    .post :global(.prose[data-numbered='3'] h3:not(#footnotes))::before {
      line-height: calc(var(--fk-subheading-size) * var(--fk-subheading-leading));
    }
  }
</style>
