---
// A detail page as an agenda entry (blog posts, projects): a rail with the
// back button, a meta block and the contents, beside one reading column. On a
// phone the rail becomes a row above the title and the contents a disclosure.
// The page fills the meta block through the "meta" slot; .rail-caption styles
// a caption line inside it.
import Base from './Base.astro';
import { inlineMarkdown } from '../lib/inlineMarkdown';

export interface Props {
  title: string;
  /** Kept for callers; the header shows the item title with the back link. */
  appName?: string;
  back: { href: string; label: string };
  /** Posts: the publish date, for the article meta tag. */
  publishedTime?: Date;
  /** Standfirst under the title. Inline markdown. */
  subtitle?: string;
  /** Credit line: a byline, a photo credit, where a piece first ran. Inline markdown. */
  attribution?: string;
  description?: string;
  mathjax?: boolean;
  /** Headings from render(post). Depth 2 and 3 make the contents. */
  headings?: { depth: number; slug: string; text: string }[];
  /** Blog long-form only: set the body in Plex Serif. Projects stay in Plex Sans. */
  serif?: boolean;
}
const {
  title,
  back,
  publishedTime,
  subtitle,
  attribution,
  description,
  mathjax,
  headings = [],
  serif = false,
} = Astro.props;

let contents = headings.filter(
  (h) => h.depth >= 2 && h.depth <= 3 && h.slug !== 'footnotes' && h.slug !== 'footnote-label',
);
// Margin numbers go on the depth with the most headings, so a post with one
// h2 and six h3 sections numbers the sections.
const count = (d: number) => contents.filter((h) => h.depth === d).length;
const numbered = count(3) > count(2) ? 3 : 2;
// A lone h2 over numbered h3 sections is the post's tagline, not a section.
if (numbered === 3 && count(2) === 1) contents = contents.filter((h) => h.depth === 3);
let n = 0;
const items = contents.map((h) => ({
  ...h,
  num: h.depth === numbered ? ++n : undefined,
}));
---
<Base {title} {description} {mathjax} {back} ogType="article" {publishedTime}>
  <div class="post-page">
    <aside class="rail">
      <div class="rail-top">
        <div class="rail-date">
          <slot name="meta" />
        </div>
      </div>
      {items.length > 0 && (
        <details class="contents" open>
          <summary>contents</summary>
          <ol>
            {items.map((h) => (
              <li class:list={{ sub: h.depth !== numbered && numbered === 2 }}>
                <a href={`#${h.slug}`}>
                  {h.num && <span class="num">{h.num}</span>}
                  <span set:html={inlineMarkdown(h.text)} />
                </a>
              </li>
            ))}
          </ol>
        </details>
      )}
    </aside>

    <article class="post">
      {subtitle && <p class="standfirst" set:html={inlineMarkdown(subtitle)} />}
      {attribution && <p class="attribution" set:html={inlineMarkdown(attribution)} />}
      <div class:list={['prose', { serif }]} data-numbered={items.some((h) => h.num) ? numbered : undefined}><slot /></div>
    </article>
  </div>
</Base>

<script>
  // Contents: open on a desktop (the rail shows it), closed on a phone. Mark
  // the section being read. Color changes only, so no motion to reduce.
  const details = document.querySelector<HTMLDetailsElement>('.contents');
  if (details) {
    const wide = matchMedia('(min-width: 1000px)');
    const sync = () => {
      details.open = wide.matches;
    };
    sync();
    wide.addEventListener('change', sync);
    // Phone: close the disclosure after a jump, so the text is in view.
    details.addEventListener('click', (e) => {
      if (!wide.matches && (e.target as HTMLElement).closest('li a')) details.open = false;
    });

    const links = [...details.querySelectorAll<HTMLAnchorElement>('li a')];
    const targets = links
      .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
      .filter((el): el is HTMLElement => !!el);
    const mark = () => {
      let current = 0;
      targets.forEach((el, i) => {
        if (el.getBoundingClientRect().top < innerHeight * 0.3) current = i;
      });
      links.forEach((a, i) => {
        if (i === current && targets[0].getBoundingClientRect().top < innerHeight * 0.3) {
          a.setAttribute('aria-current', 'location');
        } else {
          a.removeAttribute('aria-current');
        }
      });
    };
    addEventListener('scroll', mark, { passive: true });
    mark();
  }
</script>

<style>
  /* Phone: one column. The rail is a row above the title. */
  .post-page {
    display: block;
  }
  .rail-top {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .rail-date {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  /* The meta line: small and muted. A post adds .data (mono, ISO date). */
  .rail-date :global(.rail-caption) {
    margin: 0;
    font-size: var(--small-size);
    line-height: var(--small-leading);
    color: var(--muted);
  }
  .rail-date :global(.rail-caption time) {
    color: var(--text);
  }
  .rail-date :global(.rail-caption span) {
    display: block;
  }

  .contents {
    margin: var(--space-4) 0 0;
    border-top: 1px solid var(--line);
  }
  /* "contents" is an overline: the label of the list. */
  summary {
    display: flex;
    align-items: center;
    min-height: var(--touch-target);
    font-family: var(--font-mono);
    font-size: var(--overline-size);
    font-weight: 500;
    line-height: var(--overline-leading);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    cursor: pointer;
  }
  .contents ol {
    margin: 0 0 var(--space-2);
    padding: 0;
    list-style: none;
  }
  .contents li {
    max-width: none;
  }
  .contents a {
    position: relative;
    display: flex;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-2);
    min-height: var(--touch-target);
    align-items: center;
    font-size: var(--small-size);
    line-height: var(--small-leading);
    text-decoration: none;
    color: var(--muted);
  }
  /* Muted text is for base only: on the hover fill it is the text color. */
  .contents a:hover {
    color: var(--text);
    background-color: var(--hover);
  }
  .contents a:hover .num {
    color: var(--text);
  }
  /* The section being read: text color, 600, accent marker. */
  .contents a[aria-current] {
    color: var(--text);
    font-weight: 600;
  }
  .contents a[aria-current]::before {
    content: "";
    position: absolute;
    top: var(--space-1);
    bottom: var(--space-1);
    left: 0;
    width: 2px;
    background: var(--accent);
  }
  .contents li.sub a {
    padding-left: var(--space-4);
  }
  .num {
    flex: 0 0 auto;
    min-width: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--label-size);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  .post {
    display: flow-root; /* contain floated images */
    min-width: 0;
    margin-top: var(--space-4);
  }
  .standfirst {
    margin: 0 0 var(--space-4);
    font-size: var(--body-size);
    line-height: var(--body-leading);
    color: var(--muted);
  }
  .attribution {
    margin: 0 0 var(--space-6);
    font-size: var(--small-size);
    line-height: var(--small-leading);
    color: var(--muted);
  }

  /* Desktop: the rail is 240px on the grid and sticks while the text scrolls. */
  @media (min-width: 1000px) {
    .post-page {
      display: grid;
      grid-template-columns: calc(12 * var(--space-4)) minmax(0, 42rem);
      column-gap: var(--space-12);
      align-items: start;
    }
    .rail {
      position: sticky;
      top: var(--space-4);
      max-height: calc(100vh - var(--space-8));
      overflow-y: auto;
      scrollbar-width: none;
    }
    .rail-top {
      display: block;
    }
    .rail-date {
      display: block;
      margin-top: var(--space-6);
    }
    .rail-date :global(.rail-caption) {
      margin-top: var(--space-1);
    }
    .rail-date :global(.rail-caption span) {
      display: inline;
    }
    .post {
      margin-top: 0;
    }
    .contents {
      margin-top: var(--space-6);
    }
    summary {
      pointer-events: none; /* open on a desktop: a label, not a control */
      min-height: var(--space-6);
    }
    /* Section numbers hang in the gap between the rail and the text. */
    .post :global(.prose) {
      counter-reset: section;
    }
    .post :global(.prose[data-numbered='2'] h2),
    .post :global(.prose[data-numbered='3'] h3:not(#footnotes)) {
      counter-increment: section;
      position: relative;
    }
    .post :global(.prose[data-numbered='2'] h2)::before,
    .post :global(.prose[data-numbered='3'] h3:not(#footnotes))::before {
      content: counter(section);
      position: absolute;
      right: 100%;
      margin-right: var(--space-4);
      font-family: var(--font-mono);
      font-size: var(--label-size);
      font-weight: 500;
      font-variant-numeric: tabular-nums;
      line-height: calc(var(--heading-size) * var(--heading-leading));
      color: var(--muted);
    }
    .post :global(.prose[data-numbered='3'] h3:not(#footnotes))::before {
      line-height: calc(var(--subheading-size) * var(--subheading-leading));
    }
  }
</style>
